<Project Sdk="Microsoft.NET.Sdk">
  <!-- Browser end-to-end and accessibility suite (E5-S9): Playwright (Chromium, headless) + axe-core against the running
       Docker-hosted application (E2E_BASE_URL; Compose points it at the web-e2e service). -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CaseIntake.Testing\CaseIntake.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NUnit.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Deque.AxeCore.Playwright" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="CaseIntake.Testing.Assert" Alias="Assert" />
    <Using Include="CaseIntake.Testing" />
    <Using Include="Microsoft.Playwright" />
  </ItemGroup>
</Project>
