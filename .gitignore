bin/
obj/
.vs/
*.user
# Test output. Local `dotnet test` writes to artifacts/test-results (Directory.Build.props); /TestResults/ is the
# Visual Studio solution-level folder. Never ignore "TestResults/" by name: source and test folders use that name too.
/artifacts/
/TestResults/
/results/
.idea/
.DS_Store
# Guard against a relative Attachments:RootPath pointing into the tree (the default is outside it, in system temp).
# Anchored paths only: an unanchored "attachments/" would also hide the Attachments source folders.
/attachments/
/src/CaseIntake.Web/attachments/
# SonarScanner for .NET working folder (scripts/sonar.sh).
/.sonarqube/
