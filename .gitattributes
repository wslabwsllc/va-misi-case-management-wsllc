# Shell scripts run inside Linux containers: always check them out with LF line endings, whatever core.autocrlf says.
# (With CRLF the container health check and the tests service failed with "/usr/bin/env: 'bash\r'".)
*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
# YAML too: docs/contracts/veteran-lookup.spec.openapi.yaml is the Government's definition (TBS 4.6), pinned by SHA-256
# and served byte for byte by the lookup mock, so a CRLF checkout must not change its bytes.
*.yaml text eol=lf
