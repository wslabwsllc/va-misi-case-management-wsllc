<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Standalone Veteran Lookup mock (E4-S1), its own container. References ServiceDefaults only (JSON logs, SSN
       scrubbing); never Domain or application persistence (plan 0.2). Its contract is the Government definition
       (specification 4.6), embedded from docs/contracts and served verbatim at /openapi/v1.yaml; the document
       generated from this code is conformance evidence only (ADR 0008). -->
  <ItemGroup>
    <ProjectReference Include="..\CaseIntake.ServiceDefaults\CaseIntake.ServiceDefaults.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Data\veterans.json" LogicalName="CaseIntake.VeteranLookup.Mock.veterans.json" />
    <EmbeddedResource Include="..\..\docs\contracts\veteran-lookup.spec.openapi.yaml"
                      LogicalName="CaseIntake.VeteranLookup.Mock.veteran-lookup.spec.openapi.yaml" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CaseIntake.VeteranLookup.Tests" />
  </ItemGroup>
</Project>
