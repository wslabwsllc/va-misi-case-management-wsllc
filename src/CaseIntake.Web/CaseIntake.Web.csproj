<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Composition root. Program.cs merges stay one-line changes: each module adds AddXxxModule(configuration) and MapXxxEndpoints(). -->
  <PropertyGroup>
    <!-- The SDK infers this from .razor files; the Docker restore layer sees project files only, so state it explicitly
         or restore skips Microsoft.AspNetCore.App.Internal.Assets and publish ships no _framework/blazor.web.js. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CaseIntake.Attachments\CaseIntake.Attachments.csproj" />
    <ProjectReference Include="..\CaseIntake.Cases\CaseIntake.Cases.csproj" />
    <ProjectReference Include="..\CaseIntake.Identity\CaseIntake.Identity.csproj" />
    <ProjectReference Include="..\CaseIntake.Persistence\CaseIntake.Persistence.csproj" />
    <ProjectReference Include="..\CaseIntake.ServiceDefaults\CaseIntake.ServiceDefaults.csproj" />
    <ProjectReference Include="..\CaseIntake.TestResults\CaseIntake.TestResults.csproj" />
    <ProjectReference Include="..\CaseIntake.VeteranLookup.Client\CaseIntake.VeteranLookup.Client.csproj" />
  </ItemGroup>
</Project>
