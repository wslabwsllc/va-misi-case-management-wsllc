@using CaseIntake.Web.Services
@* A calendar date typed as MM-DD-YYYY (the one display format, UiText.DateFormat). A text field instead of the native
   date input, whose display follows the browser locale and cannot show MM-DD-YYYY: it is fully keyboard operable,
   accepts paste, explains its format in visible text tied by aria-describedby, and validates on change. Typed text
   that is not a real date stays in the field with an inline error (aria-invalid) and leaves the bound value unchanged,
   so nothing is ever applied or submitted from a half-typed date. TextInvalidChanged tells a form about that state so
   it can block submit and list the error in its summary; an owner that listens shows that error itself while it marks
   the field Invalid, so the inline copy is left out then and the message is not read twice. Parsing is calendar-only: no time zone, no day shift. *@
<span class="field__hint" id="@FormatId">@UiText.DateHint</span>
<span class="input-wrap input-action">
<input @attributes="AdditionalAttributes"
       id="@Id"
       type="text"
       inputmode="numeric"
       autocomplete="off"
       spellcheck="false"
       maxlength="10"
       placeholder="MM-DD-YYYY"
       value="@_text"
       @onchange="OnChangeAsync"
       aria-invalid="@(_invalid || Invalid ? "true" : null)"
       aria-describedby="@DescribedByValue" />
@* The calendar is the browser's own picker on a hidden ISO date input; ParseDate accepts its yyyy-MM-dd value. *@
<input type="date" class="date-picker-proxy" tabindex="-1" aria-hidden="true" value="@Value?.ToString("yyyy-MM-dd")" @onchange="OnChangeAsync" />
<button type="button" class="btn btn--subtle btn--icon input-action__button" aria-label="Choose date from calendar"
        data-date-picker><Icon Name="calendar" Small="true" /></button>
</span>
@if (ShowLocalError)
{
    <div class="field__error" id="@LocalErrorId">
        <Icon Name="error" Small="true" />
        <span>@UiText.DateInvalid</span>
    </div>
}

@code {
    private string _text = "";
    private bool _invalid;
    private DateOnly? _rendered;

    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter] public DateOnly? Value { get; set; }
    [Parameter] public EventCallback<DateOnly?> ValueChanged { get; set; }
    [Parameter] public EventCallback AfterChange { get; set; }
    /// <summary>Raised when the typed text becomes, or stops being, something that is not a real date.</summary>
    [Parameter] public EventCallback<bool> TextInvalidChanged { get; set; }
    /// <summary>Other descriptions (a page hint or a server error id) placed after the format hint.</summary>
    [Parameter] public string? DescribedBy { get; set; }
    /// <summary>Set by the owner when a server or form rule rejects the date.</summary>
    [Parameter] public bool Invalid { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string FormatId => Id + "-format";
    private string LocalErrorId => Id + "-format-error";
    private bool ShowLocalError => _invalid && !(Invalid && TextInvalidChanged.HasDelegate);
    private string DescribedByValue => string.Join(' ', new[] { FormatId, ShowLocalError ? LocalErrorId : null, DescribedBy }.Where(s => !string.IsNullOrEmpty(s)));

    protected override async Task OnParametersSetAsync()
    {
        // Re-render the text only when the bound value really changed (a reset, a restore from the URL), never while
        // the user's invalid text is waiting to be corrected.
        if (Value != _rendered)
        {
            _rendered = Value;
            _text = Value is { } d ? UiText.Date(d) : "";
            await SetInvalidAsync(false);
        }
    }

    private async Task OnChangeAsync(ChangeEventArgs e)
    {
        _text = e.Value?.ToString()?.Trim() ?? "";
        if (_text.Length == 0)
        {
            await CommitAsync(null);
            return;
        }
        if (UiText.ParseDate(_text) is { } date)
        {
            _text = UiText.Date(date);
            await CommitAsync(date);
            return;
        }
        await SetInvalidAsync(true);
    }

    private async Task CommitAsync(DateOnly? date)
    {
        await SetInvalidAsync(false);
        _rendered = date;
        if (date != Value)
        {
            await ValueChanged.InvokeAsync(date);
            await AfterChange.InvokeAsync();
        }
    }

    private async Task SetInvalidAsync(bool invalid)
    {
        if (_invalid != invalid)
        {
            _invalid = invalid;
            await TextInvalidChanged.InvokeAsync(invalid);
        }
    }
}
