@* Custom reconnect UI for the .NET 10 Blazor Web App (E5-S1). blazor.web.js finds the dialog by its id, adds the state
   classes (components-reconnect-show / -retrying / -failed / -paused / -resume-failed) and raises
   components-reconnect-state-changed, which ReconnectModal.razor.js turns into showModal()/close(). The dialog is
   labelled and its state text is a polite live region, so screen-reader users hear what is happening. Static (no
   circuit), so it keeps working while the connection is down. *@
<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>
<dialog id="components-reconnect-modal" data-nosnippet aria-labelledby="components-reconnect-title" aria-describedby="components-reconnect-status">
    <span class="components-rejoining-animation spinner" aria-hidden="true"></span>
    <h2 id="components-reconnect-title">Connection to the server lost</h2>
    <div id="components-reconnect-status" role="status" aria-live="polite">
        <p class="components-reconnect-first-attempt-visible">Reconnecting&hellip; Your unsaved changes are kept on this page.</p>
        <p class="components-reconnect-repeated-attempt-visible">
            Still reconnecting. Next attempt in <span id="components-seconds-to-next-attempt"></span> seconds.
        </p>
        <p class="components-reconnect-failed-visible">The connection could not be restored.</p>
        <p class="components-pause-visible">The session was paused by the server.</p>
        <p class="components-resume-failed-visible">The session could not be resumed. Reload the page to continue.</p>
    </div>
    <div class="btn-row">
        <button id="components-reconnect-button" type="button" class="btn btn--primary components-reconnect-failed-visible">Retry</button>
        <button id="components-resume-button" type="button" class="btn btn--primary components-pause-visible">Resume</button>
        <a class="btn components-resume-failed-visible" href="">Reload page</a>
    </div>
</dialog>
