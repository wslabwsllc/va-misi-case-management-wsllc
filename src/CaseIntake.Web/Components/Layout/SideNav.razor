@inherits NavigationAwareBase

@* Desktop/tablet site map: a labelled navigation landmark made of lists of links, grouped like a Power Apps sitemap. *@
@if (IsAuthenticated)
{
    var allItems = VisibleGroups.SelectMany(g => g.Items).ToList();
    <nav id="app-nav" class="app-nav @(Collapsed ? "app-nav--collapsed" : null)" aria-label="Main navigation" data-testid="side-nav">
        @foreach (var group in VisibleGroups)
        {
            var groupId = "nav-group-" + (group.Label ?? "home").Replace(' ', '-').ToLowerInvariant();
            <div class="app-nav__group">
                @if (group.Label is not null)
                {
                    <span class="app-nav__group-label" id="@groupId">@group.Label</span>
                }
                <ul aria-labelledby="@(group.Label is null ? null : groupId)">
                    @foreach (var item in group.Items)
                    {
                        <li>
                            <a class="nav-link @(item.Child ? "nav-link--child" : null)" href="@item.Href" aria-current="@CurrentAttr(item, allItems)"
                               title="@(Collapsed ? item.Text : null)">
                                <Icon Name="@item.Icon" />
                                <span class="nav-link__text">@item.Text</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }
    </nav>
}

@code {
    [Parameter] public bool Collapsed { get; set; }
}
