@page "/account/login"
@using System.ComponentModel.DataAnnotations
@using CaseIntake.Identity.Account
@using CaseIntake.Identity.Seeding
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout CaseIntake.Web.Components.Layout.AccountLayout
@inject AccountSignIn AccountSignIn
@inject NavigationManager Navigation
@inject IConfiguration Configuration

@* Static SSR (E3-S1, redesign): a plain HTTP form post with an antiforgery token; no circuit is needed to sign in. The
   existing Identity sign-in flow is unchanged. Labels are visible (no placeholder-only fields); pasting is allowed; the
   show-password button is a progressive enhancement from js/app.js (hidden until the script runs). Demo account tiles
   are links that fill in the email (?email=) and are listed only while demo accounts are seeded. *@
<PageTitle>Sign in - Case Intake and Triage</PageTitle>

@if (errorMessage is not null)
{
    @* Focus moves here after a failed attempt (autofocus on a full-page response) and role="alert" announces it. *@
    <div id="login-error" class="message message--error alert alert-error" role="alert" tabindex="-1" autofocus>
        <Icon Name="error" />
        <div class="message__body">@errorMessage</div>
    </div>
}
else if (SignedOut)
{
    <p class="pill-note pill-note--success" role="status" data-testid="signed-out"><Icon Name="circle-check" Small="true" /> You have signed out.</p>
}
else if (IsReturnToProtectedPage)
{
    <div class="message message--info" role="status" data-testid="sign-in-required">
        <Icon Name="info" />
        <div class="message__body">Sign in to continue. If you were already signed in, your session has ended.</div>
    </div>
}

<h1>Welcome back</h1>
<p>Sign in to open, triage and resolve cases with a complete record of who did what.</p>

<EditForm Model="Input" method="post" OnValidSubmit="SignInAsync" FormName="login" novalidate>
    <DataAnnotationsValidator />
    <LabeledInputText Id="login-email" Label="Email address" Type="email" AutoComplete="username" Spellcheck="false"
                      Required="true" @bind-Value="Input.Email" LeadingIcon="mail" />
    <LabeledInputText Id="login-password" Label="Password" Type="password" AutoComplete="current-password"
                      Required="true" @bind-Value="Input.Password" LeadingIcon="lock" autofocus="@(PrefillEmail is not null && errorMessage is null)">
        <LabelAside><a href="account/forgot-password" data-testid="forgot-password">Forgot password?</a></LabelAside>
        <Trailing>
            <button type="button" class="btn btn--subtle btn--icon input-action__button" data-password-toggle aria-controls="login-password"
                    aria-pressed="false" hidden data-testid="password-toggle">
                <span data-eye><Icon Name="eye" Small="true" /></span><span data-eye-off hidden><Icon Name="eye-off" Small="true" /></span>
                <span class="visually-hidden">Show password</span>
            </button>
        </Trailing>
    </LabeledInputText>
    <div class="form-actions">
        <button type="submit" class="btn btn--primary">Sign in <Icon Name="arrow-right" Small="true" /></button>
    </div>
</EditForm>

@* Listed only while demo accounts are seeded (Seed:DemoPassword set, as in docker compose and dotnet run); a deployment
   without demo seeding reveals no account names. *@
@if (!string.IsNullOrEmpty(Configuration[DemoUsers.PasswordKey]))
{
    <p class="account-divider" aria-hidden="true">Or try a demo account</p>
    <section aria-labelledby="demo-accounts-heading" data-testid="demo-accounts">
        <h2 id="demo-accounts-heading" class="visually-hidden">Demo accounts</h2>
        <ul class="demo-tiles">
            @foreach (var demo in DemoUsers.All)
            {
                var selected = string.Equals(PrefillEmail, demo.UserName, StringComparison.OrdinalIgnoreCase);
                <li>
                    <a class="demo-tile" href="@($"account/login?email={Uri.EscapeDataString(demo.UserName)}")" aria-current="@(selected ? "true" : null)" data-testid="demo-tile">
                        <span class="initials role-chip--@demo.Role.ToLowerInvariant()" aria-hidden="true">@Initials(demo.Role)</span>
                        <span>
                            <span class="demo-tile__name">@AppRoles.DisplayName(demo.Role)<span class="visually-hidden">: use @demo.UserName</span></span>
                            <span class="demo-tile__role">@RoleSummary(demo.Role)</span>
                        </span>
                    </a>
                </li>
            }
        </ul>
    </section>
}

@code {
    /// <summary>One message for every failure (unknown account, wrong password, lockout), so accounts cannot be enumerated.</summary>
    internal const string FailureMessage =
        "Sign-in failed. Check your email and password and try again. After five failed attempts, sign-in is blocked for five minutes.";

    private string? errorMessage;

    private static string RoleSummary(string role) => role switch
    {
        AppRoles.Auditor => "Read-only review",
        AppRoles.IntakeClerk => "Opens new cases",
        AppRoles.CaseWorker => "Edits and resolves",
        AppRoles.Supervisor => "Full case access",
        AppRoles.Administrator => "Every permission",
        AppRoles.QualityAnalyst => "Test results",
        _ => "",
    };

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    /// <summary>Set by the sign-out endpoint's redirect, so the page confirms the sign-out.</summary>
    [SupplyParameterFromQuery(Name = "signedOut")]
    private bool SignedOut { get; set; }

    private bool IsReturnToProtectedPage => LocalReturnUrl.IsLocal(ReturnUrl) && ReturnUrl != LocalReturnUrl.Default;

    /// <summary>A demo tile's email (?email=), filled into the form on GET; never trusted beyond that.</summary>
    [SupplyParameterFromQuery(Name = "email")]
    private string? PrefillEmail { get; set; }

    private static string Initials(string role) => role switch
    {
        AppRoles.CaseWorker => "CW",
        AppRoles.IntakeClerk => "IC",
        AppRoles.QualityAnalyst => "QA",
        _ => role[..2].ToUpperInvariant(),
    };

    protected override void OnInitialized()
    {
        Input ??= new();
        if (Input.Email is null && PrefillEmail is { Length: > 0 and <= 256 } email)
        {
            Input.Email = email;
        }
    }

    private async Task SignInAsync()
    {
        var outcome = await AccountSignIn.PasswordSignInAsync(Input.Email, Input.Password);
        if (outcome == SignInOutcome.Succeeded)
        {
            // Only application-relative return URLs are honored (open-redirect protection).
            Navigation.NavigateTo(LocalReturnUrl.Sanitize(ReturnUrl));
            return;
        }

        Input.Password = null;
        errorMessage = FailureMessage;
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Enter your email.")]
        public string? Email { get; set; }

        [Required(ErrorMessage = "Enter your password.")]
        [DataType(DataType.Password)]
        public string? Password { get; set; }
    }
}
