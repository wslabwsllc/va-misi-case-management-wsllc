@page "/account/login"
@using System.ComponentModel.DataAnnotations
@using CaseIntake.Identity.Account
@using CaseIntake.Identity.Seeding
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout CaseIntake.Web.Components.Layout.AccountLayout
@inject AccountSignIn AccountSignIn
@inject NavigationManager Navigation
@inject IConfiguration Configuration

@* Static SSR (E3-S1): a plain HTTP form post with an antiforgery token; no circuit is needed to sign in. Styled with the
   E5 kit (E5-S8). The existing Identity sign-in flow is unchanged. *@
<PageTitle>Sign in - Case Intake and Triage</PageTitle>

<h1>Sign in</h1>
<p>Welcome back. Enter your email and password to open Case Management.</p>

@if (errorMessage is not null)
{
    @* Focus moves here after a failed attempt (autofocus on a full-page response) and role="alert" announces it. *@
    <div id="login-error" class="message message--error alert alert-error" role="alert" tabindex="-1" autofocus>
        <Icon Name="error" />
        <div class="message__body">@errorMessage</div>
    </div>
}
else if (SignedOut)
{
    <div class="message message--success" role="status" data-testid="signed-out">
        <Icon Name="success" />
        <div class="message__body">You have signed out.</div>
    </div>
}
else if (IsReturnToProtectedPage)
{
    <div class="message message--info" role="status" data-testid="sign-in-required">
        <Icon Name="info" />
        <div class="message__body">Sign in to continue. If you were already signed in, your session has ended.</div>
    </div>
}

<EditForm Model="Input" method="post" OnValidSubmit="SignInAsync" FormName="login" novalidate>
    <DataAnnotationsValidator />
    <LabeledInputText Id="login-email" Label="Email address" Type="email" AutoComplete="username" Spellcheck="false"
                      Required="true" @bind-Value="Input.Email" placeholder="Enter your email" />
    <LabeledInputText Id="login-password" Label="Password" Type="password" AutoComplete="current-password"
                      Required="true" @bind-Value="Input.Password" placeholder="Enter your password" />
    <div class="form-actions">
        <button type="submit" class="btn btn--primary">Sign in</button>
    </div>
</EditForm>

@* Listed only while demo accounts are seeded (Seed:DemoPassword set, as in docker compose and dotnet run); a deployment
   without demo seeding reveals no account names. *@
@if (!string.IsNullOrEmpty(Configuration[DemoUsers.PasswordKey]))
{
    <p class="account-divider" aria-hidden="true">or use a demo account</p>
    <section class="demo-accounts" aria-labelledby="demo-accounts-heading" data-testid="demo-accounts">
        <h2 id="demo-accounts-heading">Demo accounts</h2>
        <ul>
            @foreach (var demo in DemoUsers.All)
            {
                <li><span class="mono">@demo.UserName</span> &ndash; @AppRoles.DisplayName(demo.Role): @RoleSummary(demo.Role)</li>
            }
        </ul>
    </section>
}

@code {
    /// <summary>One message for every failure (unknown account, wrong password, lockout), so accounts cannot be enumerated.</summary>
    internal const string FailureMessage =
        "Sign-in failed. Check your email and password and try again. After five failed attempts, sign-in is blocked for five minutes.";

    private string? errorMessage;

    private static string RoleSummary(string role) => role switch
    {
        AppRoles.Auditor => "read-only review of cases, audit trails and documents",
        AppRoles.IntakeClerk => "opens new cases, looks up veterans and attaches documents",
        AppRoles.CaseWorker => "edits cases, starts and resolves them",
        AppRoles.Supervisor => "case work plus triage, assigning cases, close and reopen, and managing users",
        AppRoles.Administrator => "every permission, including managing users, roles and permissions",
        AppRoles.QualityAnalyst => "reads cases; views and imports test results",
        _ => "",
    };

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    /// <summary>Set by the sign-out endpoint's redirect, so the page confirms the sign-out.</summary>
    [SupplyParameterFromQuery(Name = "signedOut")]
    private bool SignedOut { get; set; }

    private bool IsReturnToProtectedPage => LocalReturnUrl.IsLocal(ReturnUrl) && ReturnUrl != LocalReturnUrl.Default;

    protected override void OnInitialized() => Input ??= new();

    private async Task SignInAsync()
    {
        var outcome = await AccountSignIn.PasswordSignInAsync(Input.Email, Input.Password);
        if (outcome == SignInOutcome.Succeeded)
        {
            // Only application-relative return URLs are honored (open-redirect protection).
            Navigation.NavigateTo(LocalReturnUrl.Sanitize(ReturnUrl));
            return;
        }

        Input.Password = null;
        errorMessage = FailureMessage;
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Enter your email.")]
        public string? Email { get; set; }

        [Required(ErrorMessage = "Enter your password.")]
        [DataType(DataType.Password)]
        public string? Password { get; set; }
    }
}
