@page "/account/forgot-password"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout CaseIntake.Web.Components.Layout.AccountLayout

@* Password help (redesign). This application has no email service, so there is no self-service reset link: an
   administrator sets a new initial password from the Users page, and the person changes it after signing in. The page
   says so plainly instead of offering a form that could not work. *@
<PageTitle>Forgot password - Case Intake and Triage</PageTitle>

<h1>Forgot your password?</h1>
<p>Passwords are reset by an administrator. There is no email reset link in this application.</p>

<div class="message message--info" role="note" data-testid="forgot-password-help">
    <Icon Name="info" />
    <div class="message__body">
        <p class="message__title">To get back in</p>
        <ol>
            <li>Contact a supervisor or administrator of your office.</li>
            <li>They open your account under <strong>Administration › Users</strong> and give you a new initial password.</li>
            <li>Sign in with it, then choose your own password under <strong>Change password</strong>.</li>
        </ol>
        <p>After five failed attempts, sign-in is blocked for five minutes; an administrator can also unlock your account.</p>
    </div>
</div>

<div class="form-actions">
    <a class="btn btn--primary" href="account/login" data-testid="back-to-sign-in"><Icon Name="back" Small="true" /> Back to sign in</a>
</div>
