@page "/account/change-password"
@using System.ComponentModel.DataAnnotations
@using CaseIntake.Contracts.Common
@using CaseIntake.Identity
@using CaseIntake.Identity.Account
@attribute [ExcludeFromInteractiveRouting]
@layout CaseIntake.Web.Components.Layout.AccountLayout
@inject AccountPasswordChange PasswordChange

@* Static SSR like sign-in: a plain HTTP form post with an antiforgery token, so the refreshed auth cookie can be set.
   Any signed-in user may change their own password (the fallback policy requires sign-in). Passwords are never
   rendered back into the form. *@
<PageTitle>Change password - Case Intake and Triage</PageTitle>

<h1>Change password</h1>

@if (_changed)
{
    <div class="message message--success" role="status" tabindex="-1" autofocus data-testid="password-changed">
        <Icon Name="success" />
        <div class="message__body">Your password was changed. Use the new password the next time you sign in.</div>
    </div>
    <div class="form-actions">
        <a class="btn btn--primary" href="">Back to Case Management</a>
    </div>
}
else
{
    <p>Enter your current password, then choose a new one.</p>

    @if (_problems.Count > 0)
    {
        @* Focus moves here after a failed attempt (autofocus on a full-page response) and role="alert" announces it. *@
        <div id="change-password-error" class="message message--error" role="alert" tabindex="-1" autofocus data-testid="change-password-error">
            <Icon Name="error" />
            <div class="message__body">
                <p class="message__title">There is a problem</p>
                <ul>
                    @foreach (var problem in _problems)
                    {
                        <li>@problem</li>
                    }
                </ul>
            </div>
        </div>
    }

    <EditForm EditContext="_editContext" method="post" OnSubmit="ChangeAsync" FormName="change-password" novalidate>
        <LabeledInputText Id="current-password" Label="Current password" Type="password" AutoComplete="current-password"
                          Required="true" @bind-Value="Input.CurrentPassword" />
        <LabeledInputText Id="new-password" Label="New password" Type="password" AutoComplete="new-password"
                          Required="true" @bind-Value="Input.NewPassword" Hint="@IdentityModule.PasswordHint" />
        <LabeledInputText Id="confirm-password" Label="Confirm new password" Type="password" AutoComplete="new-password"
                          Required="true" @bind-Value="Input.ConfirmPassword" />
        <div class="form-actions">
            <button type="submit" class="btn btn--primary" data-testid="change-password">Change password</button>
            <a class="btn" href="">Cancel</a>
        </div>
    </EditForm>
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    private EditContext _editContext = default!;
    private ValidationMessageStore _messages = default!;
    private List<string> _problems = [];
    private bool _changed;

    protected override void OnInitialized()
    {
        Input ??= new();
        _editContext = new EditContext(Input);
        _messages = new ValidationMessageStore(_editContext);
    }

    private async Task ChangeAsync()
    {
        _messages.Clear();
        if (!string.IsNullOrEmpty(Input.NewPassword) && Input.NewPassword != Input.ConfirmPassword)
        {
            Show(nameof(InputModel.ConfirmPassword), ["The new passwords do not match."]);
        }
        else
        {
            var result = await PasswordChange.ChangeAsync(HttpContext.User, Input.CurrentPassword, Input.NewPassword);
            _changed = result.IsSuccess;
            foreach (var (field, messages) in result.Error?.FieldErrors ?? new Dictionary<string, string[]>())
            {
                Show(field, messages);
            }
            if (result.Error is { FieldErrors: null } error)
            {
                _problems.Add(error.Message);
            }
        }

        Input.CurrentPassword = Input.NewPassword = Input.ConfirmPassword = null;
        _editContext.NotifyValidationStateChanged();
    }

    private void Show(string field, string[] messages)
    {
        _messages.Add(new FieldIdentifier(Input, field), messages);
        _problems.AddRange(messages);
    }

    private sealed class InputModel
    {
        [DataType(DataType.Password)]
        public string? CurrentPassword { get; set; }

        [DataType(DataType.Password)]
        public string? NewPassword { get; set; }

        [DataType(DataType.Password)]
        public string? ConfirmPassword { get; set; }
    }
}
