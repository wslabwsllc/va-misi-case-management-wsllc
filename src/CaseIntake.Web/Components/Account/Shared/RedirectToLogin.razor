@using CaseIntake.Identity.Account
@inject NavigationManager Navigation

@* Used by the router when an anonymous user reaches a protected page during interactive navigation. A full page load
   lets the static SSR login page and the cookie handler take over. *@
@code {
    protected override void OnInitialized()
    {
        var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"{AccountRoutes.Login.TrimStart('/')}?ReturnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }
}
