@using System.Security.Claims
@using CaseIntake.Identity.CurrentUser
@using CaseIntake.Web.Services

@* Signed-in user's display name and role(s) plus the sign-out button (E3-S1; redesigned header). Roles come from the
   authenticated identity's role claims through OperationActorFactory, never from the UI. Sign-out is a plain HTTP
   form post carrying an antiforgery token to POST /account/logout; the icon buttons carry text names. *@
<AuthorizeView>
    <Authorized>
        <div class="user-status">
            <div class="user-status__identity">
                <span class="avatar" aria-hidden="true">@UiText.Initials(context.User.Identity?.Name)</span>
                <span class="user-status__text">
                    <span class="visually-hidden">Signed in as </span><strong class="user-status__name" data-testid="user-name">@context.User.Identity?.Name</strong>
                    <span class="user-status__roles"><span class="visually-hidden">Role: </span><span data-testid="user-roles">@RoleText(context.User)</span></span>
                </span>
            </div>
            <a class="btn btn--icon" href="account/change-password" data-tooltip="Change password" data-tooltip-align="end" data-testid="change-password-link">
                <Icon Name="key" Small="true" /><span class="visually-hidden">Change password</span>
            </a>
            <form method="post" action="account/logout">
                <AntiforgeryToken />
                <button type="submit" class="btn btn--icon" data-tooltip="Sign out" data-tooltip-align="end" data-testid="sign-out"><Icon Name="signout" Small="true" /><span class="visually-hidden">Sign out</span></button>
            </form>
        </div>
    </Authorized>
    <NotAuthorized>
        <a class="btn btn--primary" href="account/login">Sign in</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    private static string RoleText(ClaimsPrincipal user)
    {
        return AppRoles.Describe(OperationActorFactory.Roles(user));
    }
}
