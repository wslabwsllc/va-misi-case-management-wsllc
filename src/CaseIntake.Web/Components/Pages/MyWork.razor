@page "/my-work"
@attribute [Authorize(Policy = Permissions.CasesView)]
@implements IDisposable
@using CaseIntake.Contracts.Cases
@using CaseIntake.Contracts.Security
@using CaseIntake.Domain.Cases
@using CaseIntake.Web.Services
@inject ICaseService Cases
@inject CaseIntake.Web.Services.PageActivity Activity
@inject CaseDashboardService Dashboard
@inject ICaseWorkflow Workflow
@inject ICurrentUser CurrentUser
@inject NavigationManager Navigation
@inject TimeProvider Time

@* My tasks (redesign): cases waiting for a status change the signed-in user's role may make, longest waiting first
   ("My pending tasks" on the dashboard; owned cases are "Assigned to me"). Defined by the user's transition permissions
   (ADR 0011). Status tabs are links with counts (each a real URL, the current one marked aria-current). Each row shows
   the description, how long the case has waited since its last change, and its next step, which opens the case where
   the change is confirmed. Server-side paging. *@
<PageShell Title="My tasks" Breadcrumbs="@([new Crumb("Dashboard", "")])"
           Subtitle="Cases waiting for a status change your role can make, longest waiting first." />

<ErrorAlert Message="@_error" TestId="mywork-error" />
<p class="visually-hidden" role="status" aria-live="polite">@_announcement</p>

@if (_loading && _page is null)
{
    <LoadingIndicator Text="Loading your tasks…" />
}
else if (_actionable.Count == 0)
{
    <div class="card">
        <EmptyState Title="No tasks for your role" Message="Your role does not change case statuses, so no case waits on you." IconName="list-todo" TestId="mywork-none">
            <a class="btn" href="cases">Browse cases</a>
        </EmptyState>
    </div>
}
else if (_page is { } page)
{
    <nav aria-label="Filter tasks by status" data-testid="mywork-tabs">
        <div class="pill-tabs">
            <a href="@TabHref(null)" aria-current="@(_status is null ? "page" : null)" data-testid="mywork-tab-all">
                All <span class="badge">@_counts.Values.Sum()</span>
            </a>
            @foreach (var status in Ordered(_actionable))
            {
                var s = status;
                <a href="@TabHref(s)" aria-current="@(_status == s ? "page" : null)" data-testid="@($"mywork-tab-{s}")">
                    @UiText.Status(s) <span class="badge">@_counts.GetValueOrDefault(s)</span>
                </a>
            }
        </div>
    </nav>

    <div class="card card--flush">
        @if (page.TotalCount == 0)
        {
            <EmptyState Title="You're all caught up" Message="No case is waiting for an action you can take." IconName="list-todo" Positive="true" TestId="mywork-empty">
                <a class="btn" href="cases">Browse cases</a>
            </EmptyState>
        }
        else
        {
            <div class="task-list__head" aria-hidden="true"><span>Case and next step</span><span>Waiting</span></div>
            <ul class="task-list" aria-label="Cases waiting for you" data-testid="mywork-list">
                @foreach (var c in page.Items)
                {
                    var waited = Now - c.UpdatedAtUtc;
                    var next = NextStep(c.Status);
                    <li class="task-row" data-testid="mywork-row">
                        <span class="initials @UiText.StatusCss(c.Status)" aria-hidden="true">@Abbreviation(c.Status)</span>
                        <div class="task-row__main">
                            <a class="task-row__title" href="@($"cases/{c.Id}")">@c.Title</a>
                            <div class="task-row__meta">
                                <span class="case-id">#@c.Id</span>
                                <StatusPill Status="c.Status" />
                                <span>Since @UiText.Time(c.UpdatedAtUtc)</span>
                            </div>
                            <span class="row-desc @(string.IsNullOrWhiteSpace(c.DescriptionPreview) ? "row-desc--empty" : null)">@(string.IsNullOrWhiteSpace(c.DescriptionPreview) ? "No description provided." : c.DescriptionPreview)</span>
                        </div>
                        <span class="task-row__wait" data-testid="mywork-waiting">
                            <span class="visually-hidden">Waiting </span>@Waiting(waited)
                            <span class="meter" style="width: @MeterWidth(waited)" aria-hidden="true"></span>
                        </span>
                        @if (next is { } target)
                        {
                            <a class="btn row-raise" href="@($"cases/{c.Id}")" data-testid="mywork-next">
                                @UiText.TransitionLabel(c.Status, target)<span class="visually-hidden">: case @c.Id</span> <Icon Name="arrow-right" Small="true" />
                            </a>
                        }
                    </li>
                }
            </ul>
            <PagerControl Page="_pageNumber" PageSize="PageSize" TotalCount="page.TotalCount" Noun="cases" Label="Task pages"
                          OnPageChanged="GoToPage" Announce="false" TestIdPrefix="mywork-pager" IdPrefix="mywork-pager" />
        }
    </div>
}

@code {
    private const int PageSize = 25;
    private static readonly CaseStatus[] StatusOrder = [CaseStatus.New, CaseStatus.Triaged, CaseStatus.InProgress, CaseStatus.Resolved, CaseStatus.Closed];
    private readonly CancellationTokenSource _cts = new();
    private IReadOnlySet<CaseStatus> _actionable = new HashSet<CaseStatus>();
    private Dictionary<CaseStatus, int> _counts = [];
    private OperationActor? _actor;
    private PagedResult<CaseSummaryDto>? _page;
    private CaseStatus? _status;
    private bool _loading = true;
    private string? _error;
    private string? _announcement;
    private int _pageNumber = 1;
    private TimeSpan _longest;

    [SupplyParameterFromQuery(Name = "page")] private int? QueryPage { get; set; }
    [SupplyParameterFromQuery(Name = "status")] private string? QueryStatus { get; set; }

    private DateTimeOffset Now => Time.GetUtcNow();

    private int PageCount => _page is { TotalCount: > 0 } p ? (int)Math.Ceiling(p.TotalCount / (double)PageSize) : 1;

    private static IEnumerable<CaseStatus> Ordered(IEnumerable<CaseStatus> statuses) => StatusOrder.Where(statuses.Contains);

    protected override async Task OnParametersSetAsync()
    {
        using var busy = Activity.Begin();
        _pageNumber = QueryPage is >= 1 ? QueryPage.Value : 1;
        _loading = true;
        _error = null;
        _actor = await CurrentUser.GetAsync(_cts.Token);
        _actionable = await Dashboard.ActionableStatusesAsync(_cts.Token);
        _status = Enum.TryParse<CaseStatus>(QueryStatus, out var s) && _actionable.Contains(s) ? s : null;
        if (_actionable.Count > 0)
        {
            // One count per tab (page size 1: only the total is read).
            _counts = [];
            foreach (var status in _actionable)
            {
                var count = await Cases.ListAsync(new CaseListQuery(1, 1, [status]), _cts.Token);
                _counts[status] = count.IsSuccess ? count.Value!.TotalCount : 0;
            }
            IReadOnlyCollection<CaseStatus> wanted = _status is { } only ? [only] : [.. _actionable];
            var result = await Cases.ListAsync(new CaseListQuery(_pageNumber, PageSize, wanted, null, CaseSortField.UpdatedAt, SortDirection.Ascending), _cts.Token);
            _page = result.IsSuccess ? result.Value : null;
            _error = result.IsSuccess ? null : result.Error!.Message;
            _longest = _page is { Items.Count: > 0 } p ? p.Items.Max(c => Now - c.UpdatedAtUtc) : TimeSpan.Zero;
            _announcement = _page is null ? null : $"{_page.TotalCount} {(_page.TotalCount == 1 ? "case is" : "cases are")} waiting for you. Page {_pageNumber} of {PageCount}.";
        }
        _loading = false;
    }

    /// <summary>The first permitted forward move (else any permitted move), the action the row offers.</summary>
    private CaseStatus? NextStep(CaseStatus status)
    {
        var allowed = Workflow.NextStatuses(status).Where(to => _actor?.HasPermission(Permissions.Transition(status, to)) == true).ToList();
        return allowed.Where(to => to > status).Select(to => (CaseStatus?)to).FirstOrDefault() ?? allowed.Select(to => (CaseStatus?)to).FirstOrDefault();
    }

    private static string Abbreviation(CaseStatus status) => status switch
    {
        CaseStatus.InProgress => "IP",
        _ => UiText.Status(status)[..1],
    };

    private static string Waiting(TimeSpan waited) => waited.TotalHours switch
    {
        < 1 => "Under an hour",
        < 24 => $"{(int)waited.TotalHours} {((int)waited.TotalHours == 1 ? "hour" : "hours")}",
        _ => $"{(int)waited.TotalDays} {((int)waited.TotalDays == 1 ? "day" : "days")}",
    };

    private string MeterWidth(TimeSpan waited) =>
        _longest <= TimeSpan.Zero ? "0" : $"{Math.Max(8, Math.Round(80 * waited / _longest)).ToString(System.Globalization.CultureInfo.InvariantCulture)}px";

    private string TabHref(CaseStatus? status) => Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
    {
        ["status"] = status?.ToString(),
        ["page"] = null,
    });

    private void GoToPage(int page) => Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("page", page <= 1 ? null : page));

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
