@page "/test-results/cases"
@attribute [Authorize(Policy = Permissions.TestResultsView)]
@implements IDisposable
@using CaseIntake.Contracts.TestResults
@using CaseIntake.Domain.TestResults
@using CaseIntake.Web.Services
@using Microsoft.AspNetCore.WebUtilities
@inject ITestResultsService Results
@inject CaseIntake.Web.Services.PageActivity Activity
@inject NavigationManager Navigation
@inject ILogger<TestCases> Logger

@* Every test known to the results store with its story, requirements, accessibility classification and standards
   mapping, and latest result (failures first). Filters (including "508 Accessibility") apply as soon as they change,
   reset paging and live in the URL, so returning from a test's page restores the view. The summary counts, the list
   and "Export Filtered Results" all use the same server-side filter. A test that has never run is "Not Run". *@
<PageShell Title="Test cases" Breadcrumbs="@([new Crumb("Dashboard", ""), new Crumb("Quality assurance", "test-results")])">
    <Actions>
        <div class="btn-row page-actions">
            <a class="btn" href="@TestResultsQueryString.CasesExportHref(_query)" download data-enhance-nav="false" data-testid="export-filtered-cases">
                <Icon Name="download" Small="true" /> Export Filtered Results
            </a>
        </div>
    </Actions>
</PageShell>
<TestResultsTabs Current="cases" />

<section class="filter-panel" role="search" aria-label="Filter test cases" data-testid="case-filters">
    <div class="filter-grid">
        <div class="field">
            <label class="field__label" for="testcase-search">Name, story or requirement</label>
            <span class="input-icon">
                <Icon Name="search" Small="true" />
                <input id="testcase-search" type="search" @bind="_search" @bind:event="oninput" @bind:after="SearchChangedAsync" maxlength="200" autocomplete="off" />
            </span>
        </div>
        <div class="field">
            <label class="field__label" for="testcase-module">Module</label>
            <select id="testcase-module" value="@(_query.Module ?? "")" @onchange="e => ApplyAsync(_query with { Module = Text(e) })">
                <option value="">Any module</option>
                @foreach (var module in _modules)
                {
                    <option value="@module">@module</option>
                }
            </select>
        </div>
        <div class="field">
            <label class="field__label" for="testcase-type">Type</label>
            <select id="testcase-type" value="@(_query.Type?.ToString() ?? "")" @onchange="e => ApplyAsync(_query with { Type = Enum.TryParse<TestType>(Text(e), out var t) ? t : null })">
                <option value="">Any type</option>
                @foreach (var type in Enum.GetValues<TestType>())
                {
                    <option value="@type">@TestResultsText.Type(type)</option>
                }
            </select>
        </div>
        <div class="field">
            <label class="field__label" for="testcase-outcome">Last result</label>
            <select id="testcase-outcome" value="@(_query.LastOutcome?.ToString() ?? "")" @onchange="e => ApplyAsync(_query with { LastOutcome = Enum.TryParse<TestOutcome>(Text(e), out var o) ? o : null })">
                <option value="">Any result</option>
                @foreach (var outcome in Enum.GetValues<TestOutcome>())
                {
                    <option value="@outcome">@TestResultsText.Outcome(outcome)</option>
                }
            </select>
        </div>
        <Section508Select Id="testcase-508" Value="_query.Section508" ValueChanged="f => ApplyAsync(_query with { Section508 = f })" />
        <div class="field">
            <button type="button" class="btn btn--block" @onclick="ResetAsync" disabled="@(!HasFilters)" data-testid="reset-case-filters">
                <Icon Name="close" Small="true" /> Reset filters
            </button>
        </div>
    </div>
</section>

<p class="visually-hidden" role="status" aria-live="polite" data-testid="cases-announcement">@_announcement</p>
<ResultsSummary Id="cases-summary" Title="Last results of the matching test cases" Counts="_summary" TestId="cases-summary" />

<div class="card card--flush">
    <ErrorAlert Message="@_error" TestId="cases-error" />

    @if (_page is null && _loading)
    {
        <LoadingIndicator Text="Loading test cases…" />
    }
    else if (_page is { TotalCount: 0 })
    {
        <EmptyState Title="No test cases match" Message="Change the filters, or import a run: test cases appear after their first run." IconName="document" TestId="cases-empty" />
    }
    else if (_page is { } page)
    {
        <div class="table-wrap">
            <table class="data-grid" data-testid="cases-table">
                <caption class="visually-hidden">Test cases (@UiText.ShowingRange(_query.Page, _query.PageSize, page.TotalCount, "test cases"))</caption>
                <thead>
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Test</th>
                        <th scope="col">Last result</th>
                        <th scope="col" class="desktop-only">Module and workflow</th>
                        <th scope="col" class="desktop-only">Standards</th>
                        <th scope="col" class="desktop-only">Method</th>
                        <th scope="col" class="desktop-only">Requirements</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in page.Items)
                    {
                        <tr data-testid="case-row" data-a11y="@(c.Accessibility?.ToString() ?? "none")">
                            <td><span class="case-id">#@c.Id</span></td>
                            <td>
                                <a href="@TestResultsText.TestCaseHref(c.Id)">@c.Title</a>
                                <span class="cell-sub"><AccessibilityBadge Classification="c.Accessibility" /></span>
                            </td>
                            <td><OutcomePill Outcome="c.LastOutcome ?? TestOutcome.NotExecuted" /></td>
                            <td class="desktop-only">@c.Module<span class="cell-sub">@c.Workflow</span></td>
                            <td class="desktop-only">
                                @if (c.Section508Provision is { } provision)
                                {
                                    <span>508 @provision</span>
                                }
                                <span class="cell-sub">@TestResultsText.Wcag(c.WcagVersion, c.WcagCriterion, c.WcagLevel)</span>
                            </td>
                            <td class="desktop-only">@(c.Method is null ? "" : TestResultsText.Method(c.Method))</td>
                            <td class="desktop-only">@c.Requirements</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <PagerControl Page="_query.Page" PageSize="_query.PageSize" TotalCount="page.TotalCount" Noun="test cases" Label="Test case pages"
                      OnPageChanged="p => ApplyAsync(_query with { Page = p }, resetPage: false)" Announce="false" />
    }
</div>

@code {
    private static readonly TimeSpan SearchDelay = TimeSpan.FromMilliseconds(300);
    private readonly CancellationTokenSource _cts = new();
    private CancellationTokenSource? _debounce;
    private int _version;
    private TestCaseQuery _query = new(PageSize: TestResultsQueryString.CasePageSize);
    private PagedList<TestCaseDto>? _page;
    private TestOutcomeCounts? _summary;
    private IReadOnlyList<string> _modules = [];
    private string? _search;
    private bool _loading;
    private string? _error;
    private string? _announcement;

    // Declared so that the router re-supplies parameters when only the query string changes.
    [SupplyParameterFromQuery(Name = "q")] private string? QuerySearch { get; set; }
    [SupplyParameterFromQuery(Name = "outcome")] private string? QueryOutcome { get; set; }
    [SupplyParameterFromQuery(Name = "module")] private string? QueryModule { get; set; }
    [SupplyParameterFromQuery(Name = "type")] private string? QueryType { get; set; }
    [SupplyParameterFromQuery(Name = "a11y")] private string? QueryA11y { get; set; }
    [SupplyParameterFromQuery(Name = "page")] private string? QueryPage { get; set; }

    private bool HasFilters => _query.Module is not null || _query.Type is not null || _query.LastOutcome is not null
        || _query.Search is not null || _query.Section508 != Section508Filter.All || !string.IsNullOrWhiteSpace(_search);

    private static string? Text(ChangeEventArgs e) => e.Value?.ToString() is { Length: > 0 } v ? v : null;

    protected override async Task OnInitializedAsync()
    {
        var modules = await Results.ListModulesAsync(_cts.Token);
        _modules = modules.IsSuccess ? modules.Value! : [];
    }

    protected override async Task OnParametersSetAsync()
    {
        var values = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        _query = TestResultsQueryString.Cases(key => values.TryGetValue(key, out var v) ? v.FirstOrDefault() : null);
        if (_debounce is null)
        {
            _search = _query.Search;
        }
        await LoadAsync();
    }

    /// <summary>Every filter change goes through the URL (so Back and returning from a test restore it) and resets paging.</summary>
    private Task ApplyAsync(TestCaseQuery query, bool resetPage = true)
    {
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(TestResultsQueryString.Parameters(resetPage ? query with { Page = 1 } : query)));
        return Task.CompletedTask;
    }

    private Task ResetAsync()
    {
        _debounce?.Cancel();
        _debounce = null;
        _search = null;
        return ApplyAsync(new TestCaseQuery(PageSize: TestResultsQueryString.CasePageSize));
    }

    // @bind (not value= with @oninput) so a slow round trip never overwrites characters still being typed.
    private async Task SearchChangedAsync()
    {
        _debounce?.Cancel();
        var debounce = _debounce = CancellationTokenSource.CreateLinkedTokenSource(_cts.Token);
        try
        {
            await Task.Delay(SearchDelay, debounce.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        _debounce = null;
        await ApplyAsync(_query with { Search = string.IsNullOrWhiteSpace(_search) ? null : _search.Trim() });
    }

    private async Task LoadAsync()
    {
        var version = ++_version;
        using var busy = Activity.Begin();
        _loading = true;
        try
        {
            var page = await Results.ListTestCasesAsync(_query, _cts.Token);
            var summary = await Results.SummarizeTestCasesAsync(_query, _cts.Token);
            if (version != _version)
            {
                return;   // a newer filter change superseded this load
            }
            _page = page.IsSuccess ? page.Value : null;
            _summary = summary.IsSuccess ? summary.Value : null;
            _error = page.IsSuccess ? null : page.Error!.Message;
            _announcement = _page is null ? null : $"{UiText.Number(_page.TotalCount)} {(_page.TotalCount == 1 ? "test case matches" : "test cases match")} the filters.";
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            Logger.LogError(new EventId(5214, "TestCasesLoadFailed"), "Test case list load failed ({ExceptionType})", ex.GetType().Name);
            _page = null;
            _error = "The test cases could not be loaded. Try again.";
        }
        finally
        {
            if (version == _version)
            {
                _loading = false;
            }
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _debounce?.Dispose();
        _cts.Dispose();
    }
}
