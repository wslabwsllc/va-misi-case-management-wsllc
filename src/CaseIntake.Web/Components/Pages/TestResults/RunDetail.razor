@page "/test-results/runs/{RunId:long}"
@attribute [Authorize(Policy = Permissions.TestResultsView)]
@implements IDisposable
@using CaseIntake.Contracts.TestResults
@using CaseIntake.Domain.TestResults
@using CaseIntake.Web.Services
@inject ITestResultsService Results
@inject CaseIntake.Web.Services.PageActivity Activity
@inject ILogger<RunDetail> Logger

@* One run: summary and counts (failed, skipped, blocked and not executed kept apart), suites, the comparison with the
   previous run, every result (failures first) with its failure message, run-level evidence and the exports. *@
<PageShell Title="@PageTitle" Breadcrumbs="@([new Crumb("Dashboard", ""), new Crumb("Test runs", "test-results/runs")])" />

<ErrorAlert Message="@_error" TestId="run-error" />

@if (_run is null)
{
    @if (_loading)
    {
        <LoadingIndicator Text="Loading test run…" />
    }
}
else
{
    var r = _run.Run;
    <div class="command-bar" role="toolbar" aria-label="Run commands">
        <a class="command" href="@TestResultRoutes.Export(r.Id, "html")" download data-enhance-nav="false" data-testid="export-html"><Icon Name="export" /> Report (HTML)</a>
        <a class="command" href="@TestResultRoutes.Export(r.Id, "csv")" download data-enhance-nav="false" data-testid="export-csv"><Icon Name="export" /> Results (CSV)</a>
    </div>

    <div class="record-header" data-testid="record-header">
        <div class="record-header__top">
            <div class="record-header__title">
                <span class="page-header__subtitle">@TestResultsText.RunStatus(r.Status) · @TestResultsText.Counts(r.Counts)</span>
            </div>
            <RunResultPill Run="r" Large="true" TestId="run-result" />
        </div>
        <ul class="record-header__facts">
            <li><span class="label">Started (UTC)</span><span>@UiText.Utc(r.StartedAtUtc)</span></li>
            <li><span class="label">Duration</span><span>@UiText.Duration(r.Duration)</span></li>
            <li><span class="label">Pass rate</span><span>@TestResultsText.PassRate(r.Counts)</span></li>
            <li><span class="label">Environment</span><span>@r.Environment</span></li>
            <li><span class="label">Branch</span><span>@(r.GitBranch ?? "unknown")</span></li>
            <li><span class="label">Commit</span><span class="mono">@TestResultsText.ShortCommit(r.GitCommit)</span></li>
        </ul>
    </div>

    <div class="grid grid--main-side">
        <div class="stack">
            <section class="card card--flush" aria-labelledby="suites-heading">
                <div class="card__header"><h2 id="suites-heading">Suites</h2></div>
                <div class="table-wrap">
                    <table class="data-grid" data-testid="suites-table">
                        <caption class="visually-hidden">Suites in this run</caption>
                        <thead><tr><th scope="col">Suite</th><th scope="col">Type</th><th scope="col">Status</th><th scope="col" class="num">Tests</th><th scope="col">Message</th></tr></thead>
                        <tbody>
                            @foreach (var suite in _run.Suites)
                            {
                                <tr>
                                    <td>@suite.Name</td>
                                    <td>@TestResultsText.Type(suite.Type)</td>
                                    <td>@TestResultsText.SuiteStatus(suite.Status)</td>
                                    <td class="num">@suite.Tests</td>
                                    <td>@suite.Message</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="card card--flush" aria-labelledby="results-heading">
                <div class="card__header"><h2 id="results-heading">Results</h2></div>
                <form class="grid-toolbar" @onsubmit="ApplyAsync" @onsubmit:preventDefault="true" role="search" aria-label="Filter results" data-testid="execution-filters">
                    <div class="field grid-toolbar__search">
                        <label class="field__label" for="execution-search">Test name</label>
                        <input id="execution-search" type="search" @bind="_search" @bind:event="oninput" maxlength="200" autocomplete="off" />
                    </div>
                    <div class="field">
                        <label class="field__label" for="execution-outcome-filter">Outcome</label>
                        <select id="execution-outcome-filter" @bind="_outcome">
                            <option value="">Any outcome</option>
                            @foreach (var outcome in Enum.GetValues<TestOutcome>())
                            {
                                <option value="@outcome">@TestResultsText.Outcome(outcome)</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn--primary"><Icon Name="filter" Small="true" /> Apply filters</button>
                </form>
                <ErrorAlert Message="@_executionsError" TestId="executions-error" />
                @if (_executions is { TotalCount: 0 })
                {
                    <EmptyState Title="No results match" Message="Try a different outcome or name." IconName="search" TestId="executions-empty" />
                }
                else if (_executions is { } page)
                {
                    <div class="table-wrap">
                        <table class="data-grid" data-testid="executions-table">
                            <caption class="visually-hidden">Results in this run, failures first</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Test</th>
                                    <th scope="col">Outcome</th>
                                    <th scope="col" class="desktop-only">Module</th>
                                    <th scope="col" class="num">Duration</th>
                                    <th scope="col" class="desktop-only">Message</th>
                                    <th scope="col" class="num desktop-only">Evidence</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in page.Items)
                                {
                                    <tr>
                                        <td><a href="@TestResultsText.ExecutionHref(e.Id)">@e.TestTitle</a></td>
                                        <td><OutcomePill Outcome="e.Outcome" /></td>
                                        <td class="desktop-only">@e.Module</td>
                                        <td class="num nowrap">@UiText.Duration(e.Duration)</td>
                                        <td class="desktop-only">@e.FailureMessage</td>
                                        <td class="num desktop-only">@e.ArtifactCount</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <PagerControl Page="_query.Page" PageSize="_query.PageSize" TotalCount="page.TotalCount" Noun="results" Label="Result pages" OnPageChanged="PageAsync" />
                }
            </section>
        </div>

        <div class="stack">
            <section class="card" aria-labelledby="run-facts-heading">
                <div class="card__header"><h2 id="run-facts-heading">Run</h2></div>
                <dl class="field-list">
                    <dt>Run key</dt><dd>@r.RunKey</dd>
                    <dt>Finished (UTC)</dt><dd>@(r.FinishedAtUtc is { } f ? UiText.Utc(f) : "Not recorded")</dd>
                    <dt>Test runner</dt><dd>@r.Runner</dd>
                    <dt>Operating system</dt><dd>@_run.OperatingSystem</dd>
                    <dt>Runtime</dt><dd>@_run.Runtime</dd>
                    <dt>Application URL</dt><dd>@(_run.BaseUrl ?? "Not recorded")</dd>
                    <dt>Commit SHA</dt><dd class="mono">@(r.GitCommit ?? "unknown")</dd>
                    <dt>Build ID</dt><dd>@(r.BuildId ?? "unknown")</dd>
                    <dt>Docker image</dt><dd>@(r.ImageVersion ?? "unknown")</dd>
                    <dt>Imported (UTC)</dt><dd>@UiText.Utc(r.ImportedAtUtc)</dd>
                    @if (r.Notes is { } notes)
                    {
                        <dt>Notes</dt><dd class="pre-wrap">@notes</dd>
                    }
                </dl>
            </section>

            <section class="card" aria-labelledby="compare-heading" data-testid="run-comparison">
                <div class="card__header"><h2 id="compare-heading">Compared with the previous run</h2></div>
                @if (_comparison?.Previous is not { } previous)
                {
                    <p class="page-header__subtitle">No earlier run to compare with.</p>
                }
                else
                {
                    <p class="page-header__subtitle">Previous run: <a href="@TestResultsText.RunHref(previous.Id)">@previous.RunKey</a></p>
                    <dl class="field-list">
                        <dt>Newly failed</dt><dd>@_comparison.NewlyFailed.Count</dd>
                        <dt>Newly fixed</dt><dd>@_comparison.NewlyFixed.Count</dd>
                        <dt>Still failing</dt><dd>@_comparison.StillFailing.Count</dd>
                        <dt>New tests</dt><dd>@_comparison.NewTests.Count</dd>
                        <dt>Removed tests</dt><dd>@_comparison.RemovedTests.Count</dd>
                    </dl>
                    @if (_comparison.NewlyFailed.Count > 0)
                    {
                        <h3 class="mt-4">Newly failed</h3>
                        <ul class="compact-list">
                            @foreach (var row in _comparison.NewlyFailed)
                            {
                                <li><span class="compact-list__main"><a href="@TestResultsText.ExecutionHref(row.Id)">@row.TestTitle</a></span></li>
                            }
                        </ul>
                    }
                }
            </section>

            <section class="card" aria-labelledby="run-files-heading" data-testid="run-files">
                <div class="card__header"><h2 id="run-files-heading">Run files</h2></div>
                @if (_run.Artifacts.Count == 0)
                {
                    <p class="page-header__subtitle">No run-level files (result files and server logs) were recorded.</p>
                }
                else
                {
                    <ul class="compact-list">
                        @foreach (var a in _run.Artifacts)
                        {
                            <li>
                                <span class="compact-list__main">
                                    @if (a.Purged)
                                    {
                                        <span>@a.FileName</span>
                                    }
                                    else
                                    {
                                        <a href="@TestResultRoutes.ArtifactDownload(a.Id)" download data-enhance-nav="false">@a.FileName</a>
                                    }
                                    <br /><span class="compact-list__meta">@(a.Caption ?? TestResultsText.Kind(a.Kind)) · @UiText.FileSize(a.SizeBytes)@(a.Purged ? " · removed by retention" : null)</span>
                                </span>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>
    </div>
}

@code {
    private readonly CancellationTokenSource _cts = new();
    private TestRunDetailDto? _run;
    private TestRunComparisonDto? _comparison;
    private PagedList<TestExecutionRowDto>? _executions;
    private TestExecutionQuery _query = new();
    private string? _search;
    private TestOutcome? _outcome;
    private bool _loading;
    private string? _error;
    private string? _executionsError;

    [Parameter] public long RunId { get; set; }

    private string PageTitle => _run is { } r ? $"Run {r.Run.RunKey}" : "Test run";

    protected override async Task OnParametersSetAsync()
    {
        using var busy = Activity.Begin();
        _loading = true;
        _error = null;
        _query = new TestExecutionQuery(RunId);
        try
        {
            var run = await Results.GetRunAsync(RunId, _cts.Token);
            if (!run.IsSuccess)
            {
                _run = null;
                _error = run.Error!.Message;
                return;
            }
            _run = run.Value;
            var comparison = await Results.CompareWithPreviousAsync(RunId, _cts.Token);
            _comparison = comparison.IsSuccess ? comparison.Value : null;
            await LoadExecutionsAsync();
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            Logger.LogError(new EventId(5212, "TestRunLoadFailed"), "Test run {RunId} load failed ({ExceptionType})", RunId, ex.GetType().Name);
            _error = "The test run could not be loaded. Try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private Task ApplyAsync()
    {
        _query = _query with
        {
            Page = 1,
            Outcomes = _outcome is { } o ? [o] : null,
            Search = string.IsNullOrWhiteSpace(_search) ? null : _search.Trim(),
        };
        return LoadExecutionsAsync();
    }

    private Task PageAsync(int page)
    {
        _query = _query with { Page = page };
        return LoadExecutionsAsync();
    }

    private async Task LoadExecutionsAsync()
    {
        using var busy = Activity.Begin();
        var result = await Results.ListExecutionsAsync(_query, _cts.Token);
        _executions = result.IsSuccess ? result.Value : null;
        _executionsError = result.IsSuccess ? null : result.Error!.Message;
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
