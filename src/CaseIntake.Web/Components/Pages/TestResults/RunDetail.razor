@page "/test-results/runs/{RunId:long}"
@attribute [Authorize(Policy = Permissions.TestResultsView)]
@implements IDisposable
@using CaseIntake.Contracts.TestResults
@using CaseIntake.Domain.TestResults
@using CaseIntake.Web.Services
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation
@inject ITestResultsService Results
@inject CaseIntake.Web.Services.PageActivity Activity
@inject ILogger<RunDetail> Logger

@* One run: summary and counts (failed, skipped, blocked and not executed kept apart), suites, the comparison with the
   previous run, every result (failures first) with its failure message, run-level evidence and the exports. *@
<PageShell Title="@PageTitle" Breadcrumbs="@([new Crumb("Dashboard", ""), new Crumb("Test runs", "test-results/runs")])" />

<ErrorAlert Message="@_error" TestId="run-error" />

@if (_run is null)
{
    @if (_loading)
    {
        <LoadingIndicator Text="Loading test run…" />
    }
}
else
{
    var r = _run.Run;
    <div class="command-bar" role="toolbar" aria-label="Run commands">
        <a class="btn" href="@TestResultRoutes.Export(r.Id, "html")" download data-enhance-nav="false" data-testid="export-html"><Icon Name="download" Small="true" /> Report (HTML)</a>
        <a class="btn" href="@TestResultRoutes.Export(r.Id, "csv")" download data-enhance-nav="false" data-testid="export-csv"><Icon Name="download" Small="true" /> All results (CSV)</a>
    </div>

    <div class="record-header" data-testid="record-header">
        <div class="record-header__top">
            <div class="record-header__title">
                <span class="page-header__subtitle">@TestResultsText.RunStatus(r.Status) · @TestResultsText.Counts(r.Counts)</span>
            </div>
            <RunResultPill Run="r" Large="true" TestId="run-result" />
        </div>
        <ul class="record-header__facts">
            <li><span class="label">Started</span><span>@UiText.Time(r.StartedAtUtc)</span></li>
            <li><span class="label">Duration</span><span>@UiText.Duration(r.Duration)</span></li>
            <li><span class="label">Pass rate</span><span>@TestResultsText.PassRate(r.Counts)</span></li>
            <li><span class="label">Environment</span><span>@r.Environment</span></li>
            <li><span class="label">Branch</span><span>@(r.GitBranch ?? "unknown")</span></li>
            <li><span class="label">Commit</span><span class="mono">@TestResultsText.ShortCommit(r.GitCommit)</span></li>
        </ul>
    </div>

    <div class="grid grid--main-side">
        <div class="stack">
            <section class="card card--flush" aria-labelledby="suites-heading">
                <div class="card__header"><h2 id="suites-heading">Suites</h2></div>
                <div class="table-wrap">
                    <table class="data-grid" data-testid="suites-table">
                        <caption class="visually-hidden">Suites in this run</caption>
                        <thead><tr><th scope="col">Suite</th><th scope="col">Type</th><th scope="col">Status</th><th scope="col" class="num">Tests</th><th scope="col">Message</th></tr></thead>
                        <tbody>
                            @foreach (var suite in _run.Suites)
                            {
                                <tr>
                                    <td>@suite.Name</td>
                                    <td>@TestResultsText.Type(suite.Type)</td>
                                    <td>@TestResultsText.SuiteStatus(suite.Status)</td>
                                    <td class="num">@suite.Tests</td>
                                    <td>@suite.Message</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="card card--flush" aria-labelledby="results-heading">
                <div class="table-toolbar">
                    <h2 id="results-heading" class="table-toolbar__title">Results</h2>
                    <a class="btn" href="@TestResultsQueryString.ExecutionsExportHref(_query)" download data-enhance-nav="false" data-testid="export-filtered-results">
                        <Icon Name="download" Small="true" /> Export Filtered Results
                    </a>
                </div>
                <div class="filter-grid grid-toolbar" role="search" aria-label="Filter results" data-testid="execution-filters">
                    <div class="field">
                        <label class="field__label" for="execution-search">Test name</label>
                        <span class="input-icon">
                            <Icon Name="search" Small="true" />
                            <input id="execution-search" type="search" @bind="_search" @bind:event="oninput" @bind:after="SearchChangedAsync" maxlength="200" autocomplete="off" />
                        </span>
                    </div>
                    <div class="field">
                        <label class="field__label" for="execution-outcome-filter">Result</label>
                        <select id="execution-outcome-filter" value="@(_query.Outcomes is [var only] ? only.ToString() : "")"
                                @onchange="e => ApplyAsync(_query with { Outcomes = Enum.TryParse<TestOutcome>(e.Value?.ToString(), out var o) ? [o] : null })">
                            <option value="">Any result</option>
                            @foreach (var outcome in Enum.GetValues<TestOutcome>())
                            {
                                <option value="@outcome">@TestResultsText.Outcome(outcome)</option>
                            }
                        </select>
                    </div>
                    <Section508Select Id="execution-508" Value="_query.Section508" ValueChanged="f => ApplyAsync(_query with { Section508 = f })" />
                    <div class="field">
                        <button type="button" class="btn btn--block" @onclick="ResetAsync" disabled="@(!HasFilters)" data-testid="reset-execution-filters" data-focus-fallback="#execution-search">
                            <Icon Name="close" Small="true" /> Reset filters
                        </button>
                    </div>
                </div>
                <p class="visually-hidden" role="status" aria-live="polite" data-testid="executions-announcement">@_announcement</p>
                <div class="card__note mt-4"><ResultsSummary Id="execution-summary" Counts="_summary" TestId="execution-summary" /></div>
                <ErrorAlert Message="@_executionsError" TestId="executions-error" />
                @if (_executions is { TotalCount: 0 })
                {
                    <EmptyState Title="No results match" Message="Try a different result, name or 508 filter." IconName="search" TestId="executions-empty" />
                }
                else if (_executions is { } page)
                {
                    <div class="table-wrap">
                        <table class="data-grid" data-testid="executions-table">
                            <caption class="visually-hidden">Results in this run, failures first</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Test</th>
                                    <th scope="col">Result</th>
                                    <th scope="col" class="desktop-only">Module and workflow</th>
                                    <th scope="col" class="desktop-only">Standards</th>
                                    <th scope="col" class="num">Duration</th>
                                    <th scope="col" class="desktop-only">Message</th>
                                    <th scope="col" class="num desktop-only">Evidence</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in page.Items)
                                {
                                    <tr data-testid="execution-row" data-a11y="@(e.Accessibility?.ToString() ?? "none")">
                                        <td>
                                            <a href="@TestResultsText.ExecutionHref(e.Id)">@e.TestTitle</a>
                                            <span class="cell-sub"><AccessibilityBadge Classification="e.Accessibility" /></span>
                                        </td>
                                        <td><OutcomePill Outcome="e.Outcome" /></td>
                                        <td class="desktop-only">@e.Module<span class="cell-sub">@e.Workflow</span></td>
                                        <td class="desktop-only">
                                            @if (e.Section508Provision is { } provision)
                                            {
                                                <span>508 @provision</span>
                                            }
                                            <span class="cell-sub">@TestResultsText.Wcag(e.WcagVersion, e.WcagCriterion, e.WcagLevel)</span>
                                        </td>
                                        <td class="num nowrap">@UiText.Duration(e.Duration)</td>
                                        <td class="desktop-only">@e.FailureMessage</td>
                                        <td class="num desktop-only">@e.ArtifactCount</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <PagerControl Page="_query.Page" PageSize="_query.PageSize" TotalCount="page.TotalCount" Noun="results" Label="Result pages"
                                  OnPageChanged="p => ApplyAsync(_query with { Page = p }, resetPage: false)" Announce="false" />
                }
            </section>
        </div>

        <div class="stack">
            <section class="card" aria-labelledby="run-facts-heading">
                <div class="card__header"><h2 id="run-facts-heading">Run</h2></div>
                <dl class="field-list">
                    <dt>Run key</dt><dd>@r.RunKey</dd>
                    <dt>Finished</dt><dd>@(r.FinishedAtUtc is { } f ? UiText.Time(f) : "Not recorded")</dd>
                    <dt>Test runner</dt><dd>@r.Runner</dd>
                    <dt>Operating system</dt><dd>@_run.OperatingSystem</dd>
                    <dt>Runtime</dt><dd>@_run.Runtime</dd>
                    <dt>Application URL</dt><dd>@(_run.BaseUrl ?? "Not recorded")</dd>
                    <dt>Commit SHA</dt><dd class="mono">@(r.GitCommit ?? "unknown")</dd>
                    <dt>Build ID</dt><dd>@(r.BuildId ?? "unknown")</dd>
                    <dt>Docker image</dt><dd>@(r.ImageVersion ?? "unknown")</dd>
                    <dt>Imported</dt><dd>@UiText.Time(r.ImportedAtUtc)</dd>
                    @if (r.Notes is { } notes)
                    {
                        <dt>Notes</dt><dd class="pre-wrap">@notes</dd>
                    }
                </dl>
            </section>

            <section class="card" aria-labelledby="compare-heading" data-testid="run-comparison">
                <div class="card__header"><h2 id="compare-heading">Compared with the previous run</h2></div>
                @if (_comparison?.Previous is not { } previous)
                {
                    <p class="page-header__subtitle">No earlier run to compare with.</p>
                }
                else
                {
                    <p class="page-header__subtitle">Previous run: <a href="@TestResultsText.RunHref(previous.Id)">@previous.RunKey</a></p>
                    <dl class="field-list">
                        <dt>Newly failed</dt><dd>@_comparison.NewlyFailed.Count</dd>
                        <dt>Newly fixed</dt><dd>@_comparison.NewlyFixed.Count</dd>
                        <dt>Still failing</dt><dd>@_comparison.StillFailing.Count</dd>
                        <dt>New tests</dt><dd>@_comparison.NewTests.Count</dd>
                        <dt>Removed tests</dt><dd>@_comparison.RemovedTests.Count</dd>
                    </dl>
                    @if (_comparison.NewlyFailed.Count > 0)
                    {
                        <h3 class="mt-4">Newly failed</h3>
                        <ul class="compact-list">
                            @foreach (var row in _comparison.NewlyFailed)
                            {
                                <li><span class="compact-list__main"><a href="@TestResultsText.ExecutionHref(row.Id)">@row.TestTitle</a></span></li>
                            }
                        </ul>
                    }
                }
            </section>

            <section class="card" aria-labelledby="run-files-heading" data-testid="run-files">
                <div class="card__header"><h2 id="run-files-heading">Run files</h2></div>
                @if (_run.Artifacts.Count == 0)
                {
                    <p class="page-header__subtitle">No run-level files (result files and server logs) were recorded.</p>
                }
                else
                {
                    <ul class="compact-list">
                        @foreach (var a in _run.Artifacts)
                        {
                            <li>
                                <span class="compact-list__main">
                                    @if (a.Purged)
                                    {
                                        <span>@a.FileName</span>
                                    }
                                    else
                                    {
                                        <a href="@TestResultRoutes.ArtifactDownload(a.Id)" download data-enhance-nav="false">@a.FileName</a>
                                    }
                                    <br /><span class="compact-list__meta">@(a.Caption ?? TestResultsText.Kind(a.Kind)) · @UiText.FileSize(a.SizeBytes)@(a.Purged ? " · removed by retention" : null)</span>
                                </span>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>
    </div>
}

@code {
    private static readonly TimeSpan SearchDelay = TimeSpan.FromMilliseconds(300);
    private readonly CancellationTokenSource _cts = new();
    private CancellationTokenSource? _debounce;
    private int _version;
    private TestRunDetailDto? _run;
    private TestRunComparisonDto? _comparison;
    private PagedList<TestExecutionRowDto>? _executions;
    private TestOutcomeCounts? _summary;
    private TestExecutionQuery _query = new();
    private long? _loadedRun;
    private string? _search;
    private bool _loading;
    private string? _error;
    private string? _executionsError;
    private string? _announcement;

    [Parameter] public long RunId { get; set; }

    // Declared so that the router re-supplies parameters when only the query string changes.
    [SupplyParameterFromQuery(Name = "q")] private string? QuerySearch { get; set; }
    [SupplyParameterFromQuery(Name = "outcome")] private string? QueryOutcome { get; set; }
    [SupplyParameterFromQuery(Name = "a11y")] private string? QueryA11y { get; set; }
    [SupplyParameterFromQuery(Name = "page")] private string? QueryPage { get; set; }

    private string PageTitle => _run is { } r ? $"Run {r.Run.RunKey}" : "Test run";

    private bool HasFilters => _query.Outcomes is { Count: > 0 } || _query.Search is not null || _query.Section508 != Section508Filter.All
        || !string.IsNullOrWhiteSpace(_search);

    protected override async Task OnParametersSetAsync()
    {
        var values = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        _query = TestResultsQueryString.Executions(RunId, key => values.TryGetValue(key, out var v) ? v.FirstOrDefault() : null);
        if (_debounce is null)
        {
            _search = _query.Search;
        }
        if (_loadedRun == RunId && _run is not null)
        {
            await LoadExecutionsAsync();   // only the filters changed
            return;
        }
        using var busy = Activity.Begin();
        _loading = true;
        _error = null;
        try
        {
            var run = await Results.GetRunAsync(RunId, _cts.Token);
            if (!run.IsSuccess)
            {
                _run = null;
                _error = run.Error!.Message;
                return;
            }
            _run = run.Value;
            _loadedRun = RunId;
            var comparison = await Results.CompareWithPreviousAsync(RunId, _cts.Token);
            _comparison = comparison.IsSuccess ? comparison.Value : null;
            await LoadExecutionsAsync();
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            Logger.LogError(new EventId(5212, "TestRunLoadFailed"), "Test run {RunId} load failed ({ExceptionType})", RunId, ex.GetType().Name);
            _error = "The test run could not be loaded. Try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>Every filter change goes through the URL (so returning from a result restores it) and resets paging.</summary>
    private Task ApplyAsync(TestExecutionQuery query, bool resetPage = true)
    {
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(TestResultsQueryString.Parameters(resetPage ? query with { Page = 1 } : query)));
        return Task.CompletedTask;
    }

    private Task ResetAsync()
    {
        _debounce?.Cancel();
        _debounce = null;
        _search = null;
        return ApplyAsync(new TestExecutionQuery(RunId, PageSize: TestResultsQueryString.ExecutionPageSize));
    }

    // @bind (not value= with @oninput) so a slow round trip never overwrites characters still being typed.
    private async Task SearchChangedAsync()
    {
        _debounce?.Cancel();
        var debounce = _debounce = CancellationTokenSource.CreateLinkedTokenSource(_cts.Token);
        try
        {
            await Task.Delay(SearchDelay, debounce.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        _debounce = null;
        await ApplyAsync(_query with { Search = string.IsNullOrWhiteSpace(_search) ? null : _search.Trim() });
    }

    private async Task LoadExecutionsAsync()
    {
        var version = ++_version;
        using var busy = Activity.Begin();
        var result = await Results.ListExecutionsAsync(_query, _cts.Token);
        var summary = await Results.SummarizeExecutionsAsync(_query, _cts.Token);
        if (version != _version)
        {
            return;   // a newer filter change superseded this load
        }
        _executions = result.IsSuccess ? result.Value : null;
        _summary = summary.IsSuccess ? summary.Value : null;
        _executionsError = result.IsSuccess ? null : result.Error!.Message;
        _announcement = _executions is null ? null : $"{UiText.Number(_executions.TotalCount)} {(_executions.TotalCount == 1 ? "result matches" : "results match")} the filters.";
    }

    public void Dispose()
    {
        _cts.Cancel();
        _debounce?.Dispose();
        _cts.Dispose();
    }
}
