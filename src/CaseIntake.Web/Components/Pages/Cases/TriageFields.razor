@using CaseIntake.Contracts.Cases
@using CaseIntake.Domain.Cases
@using CaseIntake.Web.Services

@* Priority, category, owner and due date inputs (issue #22, redesign), shared by intake and edit. Priority is a radio
   group shown as segmented buttons (native radios: arrow keys move the choice; the colour swatch repeats the label).
   Each input has a programmatic label, an optional hint and its server error linked with aria-describedby /
   aria-invalid, like the text inputs of the kit. The owner list holds the users who can work cases; without CanAssign
   it is shown read-only. *@
<fieldset class="field segmented-field" aria-describedby="@Described(nameof(ITriageForm.Priority), hint: true)" data-testid="@($"{IdPrefix}-priority-group")">
    <legend class="field__label">Priority</legend>
    <span class="field__hint" id="@($"{IdPrefix}-priority-hint")">@UiText.Priority(Model.Priority) cases are due in @CaseTriageRules.TargetDays(Model.Priority) days by default.</span>
    <div class="segmented">
        @foreach (var priority in Enum.GetValues<CasePriority>().OrderDescending())
        {
            var p = priority;
            var first = p == Enum.GetValues<CasePriority>().Max();
            <label class="segmented__option">
                <input type="radio" name="@($"{IdPrefix}-priority")" id="@(first ? $"{IdPrefix}-priority" : $"{IdPrefix}-priority-{p}")" value="@p"
                       checked="@(Model.Priority == p)" @onchange="() => SetPriorityAsync(p)"
                       aria-invalid="@Invalid(nameof(ITriageForm.Priority))" data-testid="@($"{IdPrefix}-priority-{p}")" />
                <span><span class="swatch" style="background: var(--priority-@(p.ToString().ToLowerInvariant())-c)" aria-hidden="true"></span>@UiText.Priority(p)</span>
            </label>
        }
    </div>
    @Error(nameof(ITriageForm.Priority))
</fieldset>
<div class="form-grid form-grid--3" data-testid="@($"{IdPrefix}-triage")">
    <div class="field">
        <label class="field__label" for="@($"{IdPrefix}-category")">Category</label>
        <span class="field__hint" id="@($"{IdPrefix}-category-hint")">Helps route the case.</span>
        <select id="@($"{IdPrefix}-category")" @bind="Model.Category" @bind:after="OnChangedAsync"
                aria-invalid="@Invalid(nameof(ITriageForm.Category))" aria-describedby="@Described(nameof(ITriageForm.Category), hint: true)">
            @foreach (var category in Enum.GetValues<CaseCategory>().OrderBy(UiText.Category))
            {
                <option value="@category">@UiText.Category(category)</option>
            }
        </select>
        @Error(nameof(ITriageForm.Category))
    </div>
    <div class="field">
        <label class="field__label" for="@($"{IdPrefix}-owner")">Owner</label>
        @if (CanAssign)
        {
            <span class="field__hint" id="@($"{IdPrefix}-owner-hint")">People who can work cases.</span>
            <select id="@($"{IdPrefix}-owner")" @bind="Model.AssignedTo" @bind:after="OnChangedAsync"
                    aria-invalid="@Invalid(nameof(ITriageForm.AssignedTo))" aria-describedby="@Described(nameof(ITriageForm.AssignedTo), hint: true)">
                <option value="">Unassigned</option>
                @foreach (var a in Assignees)
                {
                    <option value="@a.UserName">@a.UserName (@CaseIntake.Contracts.Security.AppRoles.DisplayName(a.Role))</option>
                }
                @if (Model.AssignedTo is { Length: > 0 } current && Assignees.All(a => a.UserName != current))
                {
                    <option value="@current">@current</option>
                }
            </select>
        }
        else
        {
            <span class="field__hint" id="@($"{IdPrefix}-owner-hint")">@ReadOnlyOwnerHint</span>
            <input id="@($"{IdPrefix}-owner")" type="text" readonly value="@UiText.Owner(Model.AssignedTo)"
                   aria-describedby="@($"{IdPrefix}-owner-hint")" />
        }
        @Error(nameof(ITriageForm.AssignedTo))
    </div>
    <div class="field">
        <label class="field__label" for="@($"{IdPrefix}-due")">Due date (ET) <span class="field__required">(optional)</span></label>
        @if (DueHint is not null)
        {
            <span class="field__hint" id="@($"{IdPrefix}-due-hint")">@DueHint</span>
        }
        <DateInput Id="@($"{IdPrefix}-due")" Value="Model.DueOn" ValueChanged="SetDueAsync" TextInvalidChanged="SetDueTextInvalid"
                   Invalid="@(Invalid(nameof(ITriageForm.DueOn)) is not null)" DescribedBy="@Described(nameof(ITriageForm.DueOn), hint: DueHint is not null)" />
        @Error(nameof(ITriageForm.DueOn))
    </div>
</div>

@code {
    [CascadingParameter] private EditContext? EditContext { get; set; }

    [Parameter, EditorRequired] public string IdPrefix { get; set; } = "triage";
    [Parameter, EditorRequired] public ITriageForm Model { get; set; } = default!;
    [Parameter] public IReadOnlyList<AssigneeDto> Assignees { get; set; } = [];
    [Parameter] public bool CanAssign { get; set; }

    /// <summary>Shown under the read-only owner when <see cref="CanAssign"/> is false.</summary>
    [Parameter] public string ReadOnlyOwnerHint { get; set; } = "A supervisor assigns the owner.";
    [Parameter] public string? DueHint { get; set; }

    /// <summary>Raised after any triage input changes (for example to recompute a suggested due date).</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private Task OnChangedAsync() => OnChanged.InvokeAsync();

    private Task SetPriorityAsync(CasePriority priority)
    {
        Model.Priority = priority;
        return OnChangedAsync();
    }

    private Task SetDueAsync(DateOnly? due)
    {
        Model.DueOn = due;
        return OnChangedAsync();
    }

    private void SetDueTextInvalid(bool invalid) => Model.DueOnTextInvalid = invalid;

    private IReadOnlyList<string> Messages(string field) =>
        EditContext is null ? [] : EditContext.GetValidationMessages(new FieldIdentifier(EditContext.Model, field)).ToList();

    private string? Invalid(string field) => Messages(field).Count > 0 ? "true" : null;

    private string? Described(string field, bool hint)
    {
        var key = field switch
        {
            nameof(ITriageForm.Priority) => "priority",
            nameof(ITriageForm.Category) => "category",
            nameof(ITriageForm.AssignedTo) => "owner",
            _ => "due",
        };
        List<string> ids = [];
        if (hint)
        {
            ids.Add($"{IdPrefix}-{key}-hint");
        }
        if (Messages(field).Count > 0)
        {
            ids.Add($"{IdPrefix}-{key}-error");
        }
        return ids.Count == 0 ? null : string.Join(' ', ids);
    }

    private RenderFragment Error(string field) => builder =>
    {
        var messages = Messages(field);
        if (messages.Count == 0)
        {
            return;
        }
        var key = field switch
        {
            nameof(ITriageForm.Priority) => "priority",
            nameof(ITriageForm.Category) => "category",
            nameof(ITriageForm.AssignedTo) => "owner",
            _ => "due",
        };
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "field__error");
        builder.AddAttribute(2, "id", $"{IdPrefix}-{key}-error");
        builder.OpenComponent<Icon>(3);
        builder.AddComponentParameter(4, nameof(Icon.Name), "error");
        builder.AddComponentParameter(5, nameof(Icon.Small), true);
        builder.CloseComponent();
        builder.OpenElement(6, "span");
        builder.AddContent(7, string.Join(" ", messages));
        builder.CloseElement();
        builder.CloseElement();
    };
}
