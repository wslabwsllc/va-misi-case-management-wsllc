@page "/cases/{Id:long}"
@attribute [Authorize(Policy = Permissions.CasesView)]
@implements IDisposable
@using CaseIntake.Contracts.Cases
@using CaseIntake.Contracts.Common
@using CaseIntake.Domain.Cases
@using CaseIntake.Web.Services
@inject ICaseService Cases
@inject ICaseAssigneeDirectory Assignees
@inject ICaseAssignmentService Assignment
@inject ICurrentUser CurrentUser
@inject StatusAnnouncer Announcer
@inject NavigationManager Navigation
@inject PageActivity Activity
@inject CaseActivitySignal ActivitySignal
@inject TimeProvider Time
@inject ILogger<CaseDetail> Logger

@* Case detail (E5-S5..S7, issue #22, redesign): a header with the case ID, status and due-state badges and the commands
   (refresh, assign, edit), a summary strip with the triage fields, the workflow card (status, next step, the allowed
   transitions and the stepper), and tabs for the overview (details with the full description, veteran, audit summary
   and the in-place edit form), the attachments and the history (status history and audit trail). The record's version
   is kept with the edit form, so a save against a stale version is reported as a conflict and the user's unsaved text
   is kept visible next to the latest version. Edits are validated, then confirmed ("Are you sure you want to
   submit?"), then sent once. Inactive tab panels stay in the page (hidden), so their content keeps its state. *@
<PageShell Title="@PageTitle" DocumentTitle="@PageTitle" Breadcrumbs="@([new Crumb("Dashboard", ""), new Crumb("Cases", "cases")])" ShowBackButton="true" BackHref="cases">
    <Eyebrow>
        @if (_case is { } top)
        {
            var topDue = UiText.DueState(top.Status, top.DueOn, _today);
            <span class="case-id">CASE #@top.Id</span>
            <StatusPill Status="top.Status" />
            @if (topDue?.StartsWith("Overdue", StringComparison.Ordinal) == true)
            {
                <span class="badge badge--overdue" data-testid="header-overdue">@topDue</span>
            }
        }
    </Eyebrow>
    <TitleContent>
        @if (_case is { } named)
        {
            <span class="visually-hidden">Case @named.Id: </span>@named.Title
        }
        else
        {
            @PageTitle
        }
    </TitleContent>
    <Actions>
        @if (_case is { } header)
        {
            <div class="btn-row page-actions" role="toolbar" aria-label="Case commands" data-testid="detail-commands">
                <a class="btn mobile-only" href="cases" data-testid="back-to-cases"><Icon Name="back" Small="true" /> Back to cases</a>
                <button type="button" class="btn" @onclick="RefreshAsync" disabled="@_refreshing" aria-busy="@(_refreshing ? "true" : "false")" data-testid="detail-refresh">
                    <Icon Name="refresh" Small="true" Class="@(_refreshing ? "icon--spin" : null)" /> @(_refreshing ? "Refreshing…" : "Refresh")
                </button>
                @switch (AssignRight)
                {
                    case AssignmentRight.AssignAnyone:
                        <button type="button" class="btn" @ref="_assignButton" @onclick="OpenAssignAsync" disabled="@_assigning" aria-haspopup="dialog" data-testid="assign-case">
                            <Icon Name="user-plus" Small="true" /> @(header.AssignedTo is null ? "Assign" : "Reassign")
                        </button>
                        break;
                    case AssignmentRight.Take:
                        <button type="button" class="btn" @ref="_assignButton" @onclick="TakeAsync" disabled="@_assigning" data-testid="take-case">
                            <Icon Name="user-check" Small="true" /> Take case
                        </button>
                        break;
                    case AssignmentRight.HandBack:
                        <button type="button" class="btn" @ref="_assignButton" @onclick="HandBackAsync" disabled="@_assigning" data-testid="hand-back">
                            <Icon Name="person" Small="true" /> Hand back
                        </button>
                        break;
                }
                @if (!_editing && header.Status != CaseStatus.Closed)
                {
                    <AuthorizeView Policy="@Permissions.CasesEdit">
                        <button type="button" class="btn" @ref="_editButton" @onclick="StartEdit" data-testid="edit-case">
                            <Icon Name="edit" Small="true" /> Edit<span class="visually-hidden"> case details</span>
                        </button>
                    </AuthorizeView>
                }
            </div>
        }
    </Actions>
</PageShell>

<ErrorAlert @ref="_pageAlert" Title="@_pageErrorTitle" Message="@_pageError" TestId="detail-error">
    @if (_conflict)
    {
        <div class="btn-row">
            <button type="button" class="btn btn--primary" @onclick="ReloadLatestAsync" data-testid="reload-latest">Reload latest</button>
        </div>
    }
</ErrorAlert>

@if (_case is null)
{
    @if (_loading)
    {
        <LoadingIndicator Text="Loading case…" />
    }
}
else
{
    var c = _case;
    var dueState = UiText.DueState(c.Status, c.DueOn, _today);
    <section class="record-summary" aria-label="Case summary" data-testid="record-header">
        <dl class="summary-strip">
            <div><dt>Case ID</dt><dd data-testid="case-id">@c.Id</dd></div>
            <div><dt>Priority</dt><dd data-testid="summary-priority"><PriorityBadge Priority="c.Priority" /></dd></div>
            <div><dt>Category</dt><dd data-testid="summary-category">@UiText.Category(c.Category)</dd></div>
            <div>
                <dt>Owner</dt>
                <dd>
                    @if (c.AssignedTo is not null)
                    {
                        <span class="avatar avatar--sm avatar--soft" aria-hidden="true">@UiText.Initials(c.AssignedTo)</span>
                    }
                    <span data-testid="summary-owner">@UiText.Owner(c.AssignedTo)</span>
                </dd>
            </div>
            <div>
                <dt>Due date (ET)</dt>
                <dd data-testid="summary-due" class="@(dueState?.StartsWith("Overdue", StringComparison.Ordinal) == true ? "cell-overdue" : null)">
                    @UiText.DueDate(c.DueOn)
                    @if (dueState is not null)
                    {
                        <span class="cell-sub">@dueState</span>
                    }
                </dd>
            </div>
            <div><dt>Last modified (ET)</dt><dd>@UiText.Time(c.UpdatedAtUtc)<span class="cell-sub">by @c.UpdatedBy</span></dd></div>
        </dl>
    </section>

    <StatusTransitions Case="c" Class="card workflow-card" OnChanged="OnStatusChangedAsync" OnFailed="ReloadAfterStatusErrorAsync">
        <WorkflowStepper Status="c.Status" History="_audit" />
    </StatusTransitions>

    <div class="tabs" data-testid="detail-tabs">
        <div class="tabs__list" role="tablist" aria-label="Case sections">
            @foreach (var tab in Tabs)
            {
                var t = tab;
                <button type="button" role="tab" id="@($"tab-{t.Key}")" class="tabs__tab" aria-selected="@(_tab == t.Key ? "true" : "false")"
                        aria-controls="@($"panel-{t.Key}")" tabindex="@(_tab == t.Key ? 0 : -1)" @ref="_tabButtons[t.Key]"
                        @onclick="() => SelectTab(t.Key)" @onkeydown="e => OnTabKeyAsync(e, t.Key)" data-testid="@($"tab-{t.Key}")">
                    @t.Text
                    @if (t.Key == "attachments" && _attachmentCount is { } count)
                    {
                        @(" ")<span class="badge" data-testid="attachments-count">@count<span class="visually-hidden">@(count == 1 ? " file" : " files")</span></span>
                    }
                    @if (t.Key == "history" && _audit is { } entries)
                    {
                        @(" ")<span class="badge" data-testid="history-count">@entries.Count<span class="visually-hidden">@(entries.Count == 1 ? " entry" : " entries")</span></span>
                    }
                </button>
            }
        </div>

        <div role="tabpanel" id="panel-overview" aria-labelledby="tab-overview" tabindex="0" hidden="@(_tab != "overview")" class="tabs__panel">
            <div class="grid grid--main-side">
                <section class="card" aria-labelledby="details-heading" data-testid="details-section">
                    <div class="card__header">
                        <h2 id="details-heading">@(_editing ? "Edit case" : "Details")</h2>
                    </div>
                    @if (c.Status == CaseStatus.Closed)
                    {
                        <p class="page-header__subtitle" data-testid="closed-note">Closed cases are read-only.</p>
                    }

                    @if (_editing)
                    {
                        <EditForm EditContext="_editContext" OnSubmit="RequestSaveAsync" novalidate class="form" data-testid="edit-form">
                            <FormErrorSummary @ref="_summary" Visible="_showSummary" Fields="SummaryFields" />
                            <LabeledInputText Id="edit-title" Label="Title" Required="true" @bind-Value="_edit.Title" @ref="_titleInput"
                                              Hint="@($"{CaseFieldLimits.TitleMinLength} to {CaseFieldLimits.TitleMaxLength} characters.")"
                                              MaxCharacters="CaseFieldLimits.TitleMaxLength" />
                            <LabeledTextArea Id="edit-description" Label="Description" @bind-Value="_edit.Description" Rows="6"
                                             Hint="@($"Details of the request, up to {CaseFieldLimits.DescriptionMaxLength:N0} characters.")"
                                             MaxCharacters="CaseFieldLimits.DescriptionMaxLength" />
                            <TriageFields IdPrefix="edit" Model="_edit" Assignees="_assignees" CanAssign="false" ReadOnlyOwnerHint="Change the owner with Assign, Take case or Hand back."
                                          DueHint="Leave empty for no due date. A case past its due date while open counts as overdue." />
                            @if (_draft is { } draft)
                            {
                                <div class="message message--warning" data-testid="unsaved-draft">
                                    <Icon Name="warning" />
                                    <div class="message__body">
                                        <p class="message__title">Your unsaved text</p>
                                        <p>The form now shows the latest saved version. Your earlier changes are below; nothing was lost.</p>
                                        <p><strong>Title:</strong> <span class="pre-wrap">@draft.Title</span></p>
                                        <p><strong>Description:</strong> <span class="pre-wrap">@(string.IsNullOrEmpty(draft.Description) ? "(empty)" : draft.Description)</span></p>
                                        <button type="button" class="btn" @onclick="UseDraft" data-testid="use-draft">Use my text again</button>
                                    </div>
                                </div>
                            }
                            <div class="form-footer">
                                <span class="form-actions__note">Changes are saved only after you confirm.</span>
                                <button type="button" class="btn btn--cancel" @onclick="CancelEdit" disabled="@_saving" data-testid="cancel-edit">
                                    <Icon Name="close" Small="true" /> Cancel
                                </button>
                                <button type="submit" class="btn btn--primary" @ref="_saveButton" disabled="@_saving" aria-busy="@(_saving ? "true" : "false")" data-testid="save-case">
                                    @if (_saving)
                                    {
                                        <span class="spinner" aria-hidden="true"></span><span>Submitting…</span>
                                    }
                                    else
                                    {
                                        <span>Submit</span><Icon Name="chevrons-right" Small="true" />
                                    }
                                </button>
                            </div>
                        </EditForm>
                    }
                    else
                    {
                        <dl class="field-list">
                            <dt>Title</dt>
                            <dd data-testid="case-title">@c.Title</dd>
                            <dt>Description</dt>
                            <dd class="prose" data-testid="case-description">@(string.IsNullOrWhiteSpace(c.Description) ? "No description provided." : c.Description)</dd>
                            <dt>Case ID</dt>
                            <dd>@c.Id <span class="page-header__subtitle">(read-only)</span></dd>
                            <dt>Created (ET)</dt>
                            <dd>@UiText.Time(c.CreatedAtUtc) by @c.CreatedBy</dd>
                            <dt>Updated (ET)</dt>
                            <dd>@UiText.Time(c.UpdatedAtUtc) by @c.UpdatedBy</dd>
                        </dl>
                    }
                </section>

                <div class="stack">
                    <section class="card" aria-labelledby="veteran-heading" data-testid="veteran-section">
                        <div class="card__header"><h2 id="veteran-heading">Veteran</h2></div>
                        @if (c.Veteran is { } v)
                        {
                            <dl class="field-list">
                                <dt>Name</dt>
                                <dd>@v.Name</dd>
                                <dt>Address</dt>
                                <dd class="pre-wrap">@v.Address</dd>
                                <dt>SSN</dt>
                                <dd data-testid="ssn-last4">Ending @v.SsnLast4</dd>
                            </dl>
                        }
                        else
                        {
                            <div class="empty-box">
                                <span class="avatar avatar--empty" aria-hidden="true"><Icon Name="person" Small="true" /></span>
                                <span>No veteran was attached at intake.</span>
                            </div>
                        }
                    </section>
                    <section class="card" aria-labelledby="audit-summary-heading" data-testid="audit-summary">
                        <div class="card__header">
                            <h2 id="audit-summary-heading">Audit trail<span class="card__subtitle">Every change to this case is recorded and cannot be edited.</span></h2>
                        </div>
                        <button type="button" class="btn btn--block" @onclick="ShowHistoryAsync" data-testid="view-history">
                            <Icon Name="history" Small="true" /> View history
                        </button>
                    </section>
                </div>
            </div>
        </div>

        <div role="tabpanel" id="panel-attachments" aria-labelledby="tab-attachments" tabindex="0" hidden="@(_tab != "attachments")" class="tabs__panel">
            <AttachmentsPanel @ref="_attachments" CaseId="c.Id" Closed="@(c.Status == CaseStatus.Closed)" OnChanged="OnAttachmentUploadedAsync"
                              OnCountChanged="count => _attachmentCount = count" />
        </div>

        <div role="tabpanel" id="panel-history" aria-labelledby="tab-history" tabindex="0" hidden="@(_tab != "history")" class="tabs__panel">
            <div class="grid grid--2">
                <StatusHistory Entries="_audit" />
                <AuditTrail Entries="_audit" Error="@_auditError" />
            </div>
        </div>
    </div>

    <ConfirmSubmitDialog @ref="_confirmSave" Id="confirm-edit" TestId="confirm-edit" OnConfirm="SaveAsync"
                         Description="@($"Your changes to case {c.Id} will be saved and recorded in the audit trail.")" />

    @* Assign or reassign (supervisors): choose anyone who works cases, or Unassigned. *@
    <ModalDialog @ref="_assignDialog" Id="assign-case" Title="@($"Assign case {c.Id}")" TestId="assign-dialog"
                 Description="Choose who owns this case. The new owner is notified, and the change is recorded in the audit trail.">
        <ChildContent>
            <div class="field">
                <label class="field__label" for="assign-owner">Owner</label>
                <select id="assign-owner" @bind="_assignTarget" data-testid="assign-owner">
                    <option value="">Unassigned</option>
                    @foreach (var a in _assignees)
                    {
                        <option value="@a.UserName">@a.UserName (@CaseIntake.Contracts.Security.AppRoles.DisplayName(a.Role))</option>
                    }
                </select>
            </div>
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn--cancel" @onclick="() => _assignDialog!.CloseAsync(restoreFocus: true)" data-testid="assign-cancel">
                <Icon Name="close" Small="true" /> Cancel
            </button>
            <button type="button" class="btn btn--primary" @onclick="ConfirmAssignAsync" disabled="@_assigning" data-testid="assign-confirm">
                <Icon Name="user-check" Small="true" /> Assign
            </button>
        </Footer>
    </ModalDialog>
}

@code {
    private sealed class EditModel : ITriageForm
    {
        public string? Title { get; set; }
        public string? Description { get; set; }
        public CasePriority Priority { get; set; } = CasePriority.Medium;
        public CaseCategory Category { get; set; } = CaseCategory.General;
        public string? AssignedTo { get; set; }
        public DateOnly? DueOn { get; set; }
        public bool DueOnTextInvalid { get; set; }
    }

    private sealed record Draft(string? Title, string? Description, CaseTriage Triage);

    private sealed record Tab(string Key, string Text, string Icon);

    private static readonly Tab[] Tabs =
    [
        new("overview", "Overview", "document"),
        new("attachments", "Attachments", "attach"),
        new("history", "History", "history"),
    ];

    private static readonly IReadOnlyList<KeyValuePair<string, string>> SummaryFields =
    [
        new(CaseFieldNames.Title, "edit-title"),
        new(CaseFieldNames.Description, "edit-description"),
        .. TriageFormExtensions.SummaryFields("edit"),
    ];

    private readonly CancellationTokenSource _cts = new();
    private readonly Dictionary<string, ElementReference> _tabButtons = [];
    private CaseDetailDto? _case;
    private IReadOnlyList<AuditEntryDto>? _audit;
    private IReadOnlyList<AssigneeDto> _assignees = [];
    private string? _auditError;
    private bool _loading = true;
    private bool _refreshing;
    private bool _editing;
    private bool _saving;
    private bool _conflict;
    private bool _showSummary;
    private uint _editVersion;
    private EditModel _edit = new();
    private EditContext _editContext = new(new EditModel());
    private ValidationMessageStore? _messages;
    private Draft? _draft;
    private string? _pageError;
    private string? _pageErrorTitle;
    private ElementReference _editButton;
    private LabeledInputText? _titleInput;
    private ElementReference _saveButton;
    private ConfirmSubmitDialog? _confirmSave;
    private UpdateCaseRequest? _pendingSave;
    private FormErrorSummary? _summary;
    private ErrorAlert? _pageAlert;
    private AttachmentsPanel? _attachments;
    private int? _attachmentCount;
    private string _tab = "overview";
    private string? _focusAfterRender;
    private DateOnly _today;

    [Parameter] public long Id { get; set; }

    /// <summary>Opens a tab directly, for example <c>?tab=history</c> from a notification.</summary>
    [SupplyParameterFromQuery(Name = "tab")] private string? QueryTab { get; set; }

    /// <summary><c>?assign=true</c> (the case list's row menu) opens the Assign dialog when the user may assign.</summary>
    [SupplyParameterFromQuery(Name = "assign")] private bool QueryAssign { get; set; }

    /// <summary><c>?edit=true</c> (the case list's row menu) opens the edit form when the user may edit.</summary>
    [SupplyParameterFromQuery(Name = "edit")] private bool QueryEdit { get; set; }

    private OperationActor? _actor;
    private string? _me;
    private ModalDialog? _assignDialog;
    private ElementReference _assignButton;
    private string? _assignTarget;
    private bool _assigning;
    private bool _openAssignAfterLoad;

    /// <summary>What this user may do with the owner, by the shared rules the service enforces.</summary>
    private AssignmentRight AssignRight => _case is { } c && _actor is { } actor
        ? CaseAssignmentRules.RightFor(actor, _me, c.Status, c.AssignedTo)
        : AssignmentRight.None;

    private async Task OpenAssignAsync()
    {
        await LoadAssigneesAsync();
        _assignTarget = _case?.AssignedTo;
        await _assignDialog!.OpenAsync(() => _assignButton.FocusSafeAsync());
    }

    private Task ConfirmAssignAsync() => AssignAsync(string.IsNullOrEmpty(_assignTarget) ? null : _assignTarget, fromDialog: true);

    private Task TakeAsync() => AssignAsync(_me, fromDialog: false);

    private Task HandBackAsync() => AssignAsync(null, fromDialog: false);

    private async Task AssignAsync(string? owner, bool fromDialog)
    {
        if (_assigning || _case is null)
        {
            return;
        }
        _assigning = true;
        ClearPageError();
        using var busy = Activity.Begin();
        try
        {
            var result = await Assignment.AssignAsync(_case.Id, new AssignCaseRequest(owner, _case.Version), _cts.Token);
            if (fromDialog && _assignDialog is not null)
            {
                await _assignDialog.CloseAsync();
            }
            if (result.IsSuccess)
            {
                _case = result.Value;
                await ReloadAuditAsync();
                ActivitySignal.Raise();
                Announcer.Announce(owner is null ? "The case is now unassigned"
                    : owner == _me ? "The case is assigned to you" : $"The case is assigned to {owner}");
                _focusAfterRender = "assign";
                return;
            }
            SetPageError("The owner was not changed", result.Error!.Kind switch
            {
                ErrorKind.Conflict => "This case was changed by someone else. The latest version is shown; try again.",
                ErrorKind.Forbidden => "Your role cannot make this assignment.",
                _ => result.Error.FieldErrors?.Values.SelectMany(m => m).FirstOrDefault() ?? result.Error.Message,
            });
            await RefreshCaseAsync();
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
        finally
        {
            _assigning = false;
        }
    }

    private string PageTitle => _case is { } c ? $"Case {c.Id}: {c.Title}" : $"Case {Id}";

    protected override async Task OnParametersSetAsync()
    {
        _editing = false;
        _draft = null;
        _conflict = false;
        _pageError = null;
        _attachmentCount = null;
        // "workflow" was a tab before the redesign; its status history is now part of History.
        _tab = QueryTab == "workflow" ? "history" : Tabs.Any(t => t.Key == QueryTab) ? QueryTab! : "overview";
        _actor ??= await CurrentUser.GetAsync(_cts.Token);
        _me = CaseDashboardService.UserNameOf(_actor);
        await LoadAsync();
        _openAssignAfterLoad = QueryAssign && AssignRight == AssignmentRight.AssignAnyone;
        if (QueryEdit && _case is { Status: not CaseStatus.Closed } && _actor.HasPermission(Permissions.CasesEdit))
        {
            await StartEdit();
        }
    }

    private async Task LoadAsync()
    {
        using var busy = Activity.Begin();
        _loading = true;
        _today = UiText.Today(Time);
        try
        {
            var result = await Cases.GetAsync(Id, _cts.Token);
            if (!result.IsSuccess)
            {
                if (result.Error!.Kind == ErrorKind.NotFound)
                {
                    Navigation.NotFound();   // .NET 10: renders the Router's NotFoundPage (HTTP 404 when prerendered)
                    return;
                }
                _case = null;
                SetPageError("The case could not be opened", result.Error.Message);
                return;
            }
            _case = result.Value;
            await ReloadAuditAsync();
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            Logger.LogError(new EventId(5005, "CaseDetailLoadFailed"), "Case detail load failed for {CaseId} ({ExceptionType})", Id, ex.GetType().Name);
            SetPageError("The case could not be opened", "Something went wrong while loading the case. Try again.");
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>Refresh command: reloads the case, its audit trail and attachments, and says so.</summary>
    private async Task RefreshAsync()
    {
        if (_refreshing)
        {
            return;
        }
        _refreshing = true;
        try
        {
            using var busy = Activity.Begin();
            await Task.WhenAll(RefreshCaseAsync(), Task.Delay(TimeSpan.FromMilliseconds(400), _cts.Token));
            if (_attachments is not null)
            {
                await _attachments.ReloadAsync();
            }
            Announcer.Announce("Case refreshed");
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
        finally
        {
            _refreshing = false;
        }
    }

    private async Task ReloadAuditAsync()
    {
        var audit = await Cases.GetAuditTrailAsync(Id, _cts.Token);
        _audit = audit.IsSuccess ? audit.Value : null;
        _auditError = audit.IsSuccess ? null : audit.Error!.Message;
    }


    /// <summary>"View history" on the overview: opens the History tab and moves focus to it.</summary>
    private async Task ShowHistoryAsync()
    {
        _tab = "history";
        StateHasChanged();
        if (_tabButtons.TryGetValue("history", out var button))
        {
            await button.FocusSafeAsync();
        }
    }
    private void SelectTab(string key)
    {
        _tab = key;
    }

    /// <summary>Tabs pattern: arrow keys move between tabs (wrapping), Home and End go to the first and last.</summary>
    private async Task OnTabKeyAsync(KeyboardEventArgs e, string current)
    {
        // Move from the selected tab, not the one that received the key: with fast repeated presses, the next key can
        // arrive before focus has moved, and events are handled in order, so the selection is always up to date.
        var index = Array.FindIndex(Tabs, t => t.Key == _tab);
        if (index < 0)
        {
            index = Array.FindIndex(Tabs, t => t.Key == current);
        }
        var next = e.Key switch
        {
            "ArrowRight" => (index + 1) % Tabs.Length,
            "ArrowLeft" => (index - 1 + Tabs.Length) % Tabs.Length,
            "Home" => 0,
            "End" => Tabs.Length - 1,
            _ => -1,
        };
        if (next < 0)
        {
            return;
        }
        _tab = Tabs[next].Key;
        StateHasChanged();
        if (_tabButtons.TryGetValue(_tab, out var button))
        {
            await button.FocusSafeAsync();
        }
    }

    private void SetPageError(string title, string message, bool conflict = false)
    {
        _pageErrorTitle = title;
        _pageError = message;
        _conflict = conflict;
        _focusAfterRender = "alert";
    }

    private void ClearPageError()
    {
        _pageErrorTitle = null;
        _pageError = null;
        _conflict = false;
    }

    private async Task StartEdit()
    {
        if (_case is null)
        {
            return;
        }
        ClearPageError();
        _tab = "overview";
        LoadForm(_case);
        _showSummary = false;
        _draft = null;
        _editing = true;
        _focusAfterRender = "title";
        await LoadAssigneesAsync();
    }

    private void LoadForm(CaseDetailDto c)
    {
        _edit = new EditModel { Title = c.Title, Description = c.Description };
        _edit.Load(c.Triage);
        _editVersion = c.Version;
        _editContext = new EditContext(_edit);
        _messages = new ValidationMessageStore(_editContext);
    }

    private async Task LoadAssigneesAsync()
    {
        if (_assignees.Count > 0)
        {
            return;
        }
        try
        {
            var result = await Assignees.ListAsync(_cts.Token);
            _assignees = result.IsSuccess ? result.Value! : [];
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // The owner list keeps the current owner and Unassigned; the server validates any change.
            Logger.LogWarning(new EventId(5010, "AssigneeListFailed"), "Assignee list failed ({ExceptionType})", ex.GetType().Name);
        }
    }

    private void CancelEdit()
    {
        // The view shows the saved values again; nothing from the form is kept.
        _editing = false;
        _draft = null;
        _showSummary = false;
        ClearPageError();
        _focusAfterRender = "edit";
    }

    /// <summary>Submit: validate with the server's rules first, then ask "Are you sure you want to submit?".</summary>
    private async Task RequestSaveAsync()
    {
        if (_saving || _case is null || _messages is null || (_confirmSave?.IsOpen ?? false))
        {
            return;
        }
        var request = new UpdateCaseRequest(_edit.Title ?? string.Empty, _edit.Description, _editVersion, _edit.ToTriage());
        if (_edit.WithDueOnText(CaseRequestValidator.Validate(request)) is { } invalid)
        {
            ShowValidation(invalid);
            return;
        }
        _messages.Clear();
        _showSummary = false;
        _editContext.NotifyValidationStateChanged();
        _pendingSave = request;
        await _confirmSave!.OpenAsync(() => _saveButton.FocusSafeAsync());
    }

    /// <summary>Confirmed: send the validated request exactly once; the form keeps its values if it fails.</summary>
    private async Task SaveAsync()
    {
        if (_saving || _case is null || _messages is null || _pendingSave is not { } request)
        {
            return;
        }
        _pendingSave = null;
        _saving = true;
        ClearPageError();
        using var busy = Activity.Begin();
        try
        {
            var result = await Cases.UpdateAsync(_case.Id, request, _cts.Token);
            if (result.IsSuccess)
            {
                _case = result.Value;
                _editing = false;
                _draft = null;
                await ReloadAuditAsync();
                Announcer.Announce("Changes saved");
                ActivitySignal.Raise();
                _focusAfterRender = "edit";
                return;
            }

            switch (result.Error!.Kind)
            {
                case ErrorKind.Validation when result.Error.FieldErrors is { Count: > 0 }:
                    ShowValidation(result.Error);
                    break;
                case ErrorKind.Conflict:
                    SetPageError("Someone else changed this case", result.Error.Message + " Your unsaved text is still in the form.", conflict: true);
                    break;
                default:
                    SetPageError("Your changes were not saved", result.Error.Message);
                    await RefreshCaseAsync();
                    if (_case is { Status: CaseStatus.Closed })
                    {
                        // Closed by someone else while editing (CaseClosed): the case is read-only now, so leave edit mode.
                        _editing = false;
                        _draft = null;
                    }
                    break;
            }
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            Logger.LogError(new EventId(5006, "CaseEditFailed"), "Case edit failed for {CaseId} ({ExceptionType})", Id, ex.GetType().Name);
            SetPageError("Your changes were not saved", "Something went wrong. Your text is still in the form; try again.");
        }
        finally
        {
            _saving = false;
        }
    }

    private void ShowValidation(Error error)
    {
        _messages!.Clear();
        foreach (var (field, fieldMessages) in error.FieldErrors ?? new Dictionary<string, string[]>())
        {
            var target = field is CaseFieldNames.Title or CaseFieldNames.Description || TriageFormExtensions.IsTriageField(field)
                ? field
                : CaseFieldNames.Title;
            _messages.Add(new FieldIdentifier(_edit, target), fieldMessages);
        }
        _showSummary = true;
        _focusAfterRender = "summary";
        _editContext.NotifyValidationStateChanged();
    }

    /// <summary>Conflict recovery: load the latest version into the form and keep the user's text alongside it.</summary>
    private async Task ReloadLatestAsync()
    {
        var draft = new Draft(_edit.Title, _edit.Description, _edit.ToTriage());
        var result = await Cases.GetAsync(Id, _cts.Token);
        if (!result.IsSuccess)
        {
            SetPageError("The latest version could not be loaded", result.Error!.Message, conflict: true);
            return;
        }
        _case = result.Value;
        await ReloadAuditAsync();
        ClearPageError();
        if (_case!.Status == CaseStatus.Closed)
        {
            // The case was closed meanwhile and can no longer be edited; keep the text visible as a read-only draft.
            _editing = false;
            SetPageError("This case was closed", $"Closed cases cannot be edited. Your unsaved title was: \"{draft.Title}\".");
            return;
        }
        LoadForm(_case);
        _showSummary = false;
        _draft = draft;
        Announcer.Announce("Latest version loaded. Your unsaved text is shown below the form.");
        _focusAfterRender = "title";
    }

    private void UseDraft()
    {
        if (_draft is null)
        {
            return;
        }
        _edit.Title = _draft.Title;
        _edit.Description = _draft.Description;
        _edit.Load(_draft.Triage);
        _draft = null;
        _focusAfterRender = "title";
    }

    private async Task RefreshCaseAsync()
    {
        _today = UiText.Today(Time);
        var latest = await Cases.GetAsync(Id, _cts.Token);
        if (latest.IsSuccess)
        {
            _case = latest.Value;
            await ReloadAuditAsync();
        }
    }

    private async Task OnStatusChangedAsync(CaseDetailDto updated)
    {
        _case = updated;
        _editing = false;
        _draft = null;
        ClearPageError();
        await ReloadAuditAsync();
        ActivitySignal.Raise();
    }

    private async Task OnAttachmentUploadedAsync()
    {
        await ReloadAuditAsync();
        ActivitySignal.Raise();
    }

    /// <summary>After InvalidTransition, Forbidden or Conflict the displayed status is refreshed (E5-S6).</summary>
    private Task ReloadAfterStatusErrorAsync() => RefreshCaseAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_openAssignAfterLoad && _assignDialog is not null && RendererInfo.IsInteractive)
        {
            _openAssignAfterLoad = false;
            await OpenAssignAsync();
        }
        var target = _focusAfterRender;
        _focusAfterRender = null;
        switch (target)
        {
            case "assign":
                // Take case becomes Hand back (and the reverse): focus the button that is there now.
                await _assignButton.FocusSafeAsync();
                break;
            case "title" when _titleInput is not null:
                await _titleInput.FocusAsync();
                break;
            case "edit":
                // No-op when there is no Edit button (the case is closed now or the user lacks cases.edit).
                await _editButton.FocusSafeAsync();
                break;
            case "summary" when _summary is not null:
                await _summary.FocusAsync();
                break;
            case "alert" when _pageAlert is not null:
                await _pageAlert.FocusAsync();
                break;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
