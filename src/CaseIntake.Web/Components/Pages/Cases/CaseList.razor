@page "/cases"
@attribute [Authorize(Policy = Permissions.CasesView)]
@implements IDisposable
@using CaseIntake.Contracts.Cases
@using CaseIntake.Domain.Cases
@using CaseIntake.Web.Services
@using Microsoft.AspNetCore.WebUtilities
@inject ICaseService Cases
@inject ICaseAssigneeDirectory Assignees
@inject ICurrentUser CurrentUser
@inject NavigationManager Navigation
@inject PageActivity Activity
@inject StatusAnnouncer Announcer
@inject TimeProvider Time
@inject ILogger<CaseList> Logger

@* All cases (E5-S3, redesign): server-side paging, filtering and sorting through ICaseService.ListAsync. Filters apply
   as soon as they change (search after a 300 ms pause), always return to page 1 and are kept in the URL, so reload,
   share and Back restore the view. A response that arrives after a newer request is ignored. The result count is
   announced politely. Wide screens get a semantic table whose title link covers the row; phones get record cards. *@
<PageShell Title="Cases" Breadcrumbs="@([new Crumb("Dashboard", "")])" Subtitle="Find, filter and open every case you are allowed to see.">
    <Actions>
        <div class="btn-row page-actions" role="toolbar" aria-label="Case commands">
            <button type="button" class="btn" @onclick="RefreshAsync" disabled="@_loading" aria-busy="@(_loading ? "true" : "false")" data-testid="refresh">
                <Icon Name="refresh" Small="true" Class="@(_refreshing ? "icon--spin" : null)" /> @(_refreshing ? "Refreshing…" : "Refresh")
            </button>
            <a class="btn" href="@ExportHref" download data-enhance-nav="false" data-testid="export-csv"><Icon Name="download" Small="true" /> @ExportLabel</a>
            <AuthorizeView Policy="@Permissions.CasesCreate">
                <a class="btn btn--primary" href="cases/new" data-testid="new-case"><Icon Name="file-plus" Small="true" /> New case</a>
            </AuthorizeView>
        </div>
    </Actions>
</PageShell>

<section class="filter-panel" role="search" aria-label="Filter cases" data-testid="case-filters">
    <div class="field filter-search">
        <label class="field__label" for="case-search">Search by case ID, title or description</label>
        <span class="input-icon input-icon--lg">
            <Icon Name="search" Small="true" />
            <input id="case-search" type="search" @bind="_searchDraft" @bind:event="oninput" @bind:after="SearchChangedAsync" @onkeydown="OnSearchKeyDown"
                   maxlength="@CaseFieldLimits.SearchMaxLength" enterkeyhint="search" autocomplete="off" aria-describedby="case-search-hint" />
        </span>
        <span class="field__hint" id="case-search-hint">Results update as you type.</span>
    </div>
    <div class="filter-grid case-filter-grid">
        <div class="field">
            <label class="field__label" for="filter-status">Status</label>
            <select id="filter-status" value="@Encode(_state.Statuses)" @onchange="StatusChangedAsync" data-testid="filter-status">
                <option value="">All statuses</option>
                <option value="@Encode(OpenStatuses)">Open (New, Triaged, In Progress)</option>
                @foreach (var status in Enum.GetValues<CaseStatus>())
                {
                    <option value="@status">@UiText.Status(status)</option>
                }
                <option value="@Encode(CompletedStatuses)">Resolved or Closed</option>
                @if (_state.Statuses.Count > 1 && !IsPreset(_state.Statuses))
                {
                    <option value="@Encode(_state.Statuses)">@string.Join(", ", _state.Statuses.Select(UiText.Status))</option>
                }
            </select>
        </div>
        <div class="field">
            <label class="field__label" for="filter-priority">Priority</label>
            <select id="filter-priority" value="@Encode(_state.Priorities)" @onchange="PriorityChangedAsync" data-testid="filter-priority">
                <option value="">All priorities</option>
                @foreach (var priority in Enum.GetValues<CasePriority>().OrderDescending())
                {
                    <option value="@priority">@UiText.Priority(priority)</option>
                }
                @if (_state.Priorities.Count > 1)
                {
                    <option value="@Encode(_state.Priorities)">@string.Join(", ", _state.Priorities.Select(UiText.Priority))</option>
                }
            </select>
        </div>
        <div class="field">
            <label class="field__label" for="case-category">Category</label>
            <select id="case-category" value="@Encode(_state.Categories)" @onchange="CategoryChangedAsync" data-testid="filter-category">
                <option value="">All categories</option>
                @foreach (var category in Enum.GetValues<CaseCategory>().OrderBy(UiText.Category))
                {
                    <option value="@category">@UiText.Category(category)</option>
                }
            </select>
        </div>
        <div class="field">
            <label class="field__label" for="case-owner">Owner</label>
            <select id="case-owner" value="@(_state.Owner ?? "")" @onchange="OwnerChangedAsync" data-testid="filter-owner">
                <option value="">All</option>
                @if (_me is not null)
                {
                    <option value="@_me">Me (@_me)</option>
                }
                <option value="@CaseListQuery.UnassignedFilter">Unassigned</option>
                @foreach (var a in _assignees.Where(a => a.UserName != _me))
                {
                    <option value="@a.UserName">@a.UserName</option>
                }
                @if (_state.Owner is { Length: > 0 } other && other != _me && other != CaseListQuery.UnassignedFilter && _assignees.All(a => a.UserName != other))
                {
                    <option value="@other">@other</option>
                }
            </select>
        </div>
        <div class="field">
            <label class="field__label" for="filter-due-from">Due from</label>
            <DateInput Id="filter-due-from" Value="_state.DueFrom" ValueChanged="DueFromChangedAsync" data-testid="filter-due-from" />
        </div>
        <div class="field">
            <label class="field__label" for="filter-due-to">Due to</label>
            <DateInput Id="filter-due-to" Value="_state.DueTo" ValueChanged="DueToChangedAsync" data-testid="filter-due-to"
                       Invalid="@DueRangeInvalid" DescribedBy="@(DueRangeInvalid ? "filter-due-range-error" : null)" />
            @if (DueRangeInvalid)
            {
                <div class="field__error" id="filter-due-range-error"><Icon Name="error" Small="true" /><span>Due to must be on or after Due from.</span></div>
            }
        </div>
        <div class="field mobile-only">
            <label class="field__label" for="case-sort">Sort by</label>
            <select id="case-sort" value="@SortValue" @onchange="SortFromSelectAsync">
                @foreach (var option in SortOptions)
                {
                    <option value="@option.Value">@option.Text</option>
                }
            </select>
        </div>
    </div>
    <div class="filter-row">
        <label class="checkbox">
            <input type="checkbox" checked="@_state.Overdue" @onchange="OverdueChangedAsync" data-testid="filter-overdue" />
            Overdue only
        </label>
        <button type="button" class="btn" @onclick="ClearFiltersAsync" disabled="@(!HasFilters)" data-testid="clear-filters" data-focus-fallback="#case-search">
            <Icon Name="close" Small="true" /> Clear filters
        </button>
    </div>
</section>

<div class="card card--flush results-card">
    <div class="table-toolbar">
        <h2 class="table-toolbar__title" id="results-heading">Cases <span class="page-header__subtitle" data-testid="results-count">@CountText</span></h2>
    </div>
    @if (DateChips.Count > 0)
    {
        <div class="filter-chips" role="group" aria-label="Date filters" data-testid="filter-chips">
            @foreach (var chip in DateChips)
            {
                var c = chip;
                <span class="chip">
                    @c.Text
                    <button type="button" class="chip__remove" @onclick="() => NavigateAsync(c.Remove(_state))" data-focus-fallback="#results-heading" aria-label="@($"Remove filter: {c.Text}")">
                        <Icon Name="close" Small="true" />
                    </button>
                </span>
            }
        </div>
    }

    <ErrorAlert Message="@_error" TestId="list-error" />

    @* Polite live region: announces the number of results after every load (E5-S3, WCAG 4.1.3). *@
    <p class="visually-hidden" role="status" aria-live="polite" data-testid="results-announcement">@_announcement</p>

    @if (_result is null && _loading)
    {
        <LoadingIndicator Text="Loading cases…" />
    }
    else if (_result is { } page)
    {
        @if (page.TotalCount == 0)
        {
            <EmptyState Title="No cases match these filters" Message="Try a different search or fewer filters." IconName="search" TestId="list-empty">
                @if (HasFilters)
                {
                    <button type="button" class="btn" @onclick="ClearFiltersAsync" data-focus-fallback="#results-heading">Clear filters</button>
                }
            </EmptyState>
        }
        else
        {
            <div class="table-wrap desktop-only">
                <table class="data-grid" aria-busy="@(_loading ? "true" : "false")" aria-labelledby="results-heading" data-testid="case-table">
                    <thead>
                        <tr>
                            @foreach (var column in Columns)
                            {
                                <th scope="col" aria-sort="@(column.Field is { } f ? AriaSort(f) : null)">
                                    @if (column.Field is { } sortField)
                                    {
                                        <button type="button" class="sort-button" @onclick="() => SortAsync(sortField)" data-testid="@($"sort-{sortField}")">
                                            @column.Text
                                            <span class="sort-indicator @(_state.SortBy == sortField ? "sort-indicator--active" : null)" aria-hidden="true">@SortGlyph(sortField)</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="visually-hidden">@column.Text</span>
                                    }
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in page.Items)
                        {
                            var dueState = UiText.DueState(c.Status, c.DueOn, _today);
                            <tr class="row-link" data-testid="case-row">
                                <td><span class="case-id">#@c.Id</span></td>
                                <td class="col-title">
                                    <a class="row-link__title" href="@($"cases/{c.Id}")">@c.Title</a>
                                    <span class="row-desc @(string.IsNullOrWhiteSpace(c.DescriptionPreview) ? "row-desc--empty" : null)" data-testid="row-description">@Preview(c.DescriptionPreview)</span>
                                </td>
                                <td><StatusPill Status="c.Status" /></td>
                                <td><PriorityBadge Priority="c.Priority" /></td>
                                <td>@UiText.Category(c.Category)</td>
                                <td><span class="cell-owner">@if (c.AssignedTo is not null)
                                    {
                                        <span class="avatar avatar--sm avatar--soft" aria-hidden="true">@UiText.Initials(c.AssignedTo)</span>
                                    }@UiText.Owner(c.AssignedTo)</span></td>
                                <td class="nowrap @(dueState?.StartsWith("Overdue", StringComparison.Ordinal) == true ? "cell-overdue" : null)">
                                    @UiText.DueDate(c.DueOn)
                                    @if (dueState is not null)
                                    {
                                        <span class="cell-sub">@dueState</span>
                                    }
                                </td>
                                <td class="nowrap">@UiText.TimeNoZone(c.UpdatedAtUtc)</td>
                                <td class="cell-actions">
                                    @* Row menu: a disclosure of links (no script), raised above the row's covering link. *@
                                    <details class="row-menu row-raise" data-testid="row-menu">
                                        <summary class="btn btn--subtle btn--icon" aria-label="@($"Actions for case {c.Id}")"><Icon Name="more" Small="true" /></summary>
                                        <ul class="row-menu__list">
                                            <li><a href="@($"cases/{c.Id}")">Open case</a></li>
                                            @if (c.Status != CaseStatus.Closed)
                                            {
                                                <AuthorizeView Policy="@Permissions.CasesEdit" Context="editAuth">
                                                    <li><a href="@($"cases/{c.Id}?edit=true")" data-testid="row-edit">Edit…</a></li>
                                                </AuthorizeView>
                                                <AuthorizeView Policy="@Permissions.CasesAssign" Context="assignAuth">
                                                    <li><a href="@($"cases/{c.Id}?assign=true")" data-testid="row-assign">Assign…</a></li>
                                                </AuthorizeView>
                                            }
                                            <li><a href="@($"cases/{c.Id}?tab=attachments")">Attachments</a></li>
                                            <li><a href="@($"cases/{c.Id}?tab=history")">History</a></li>
                                        </ul>
                                    </details>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <ul class="record-list mobile-only" aria-label="Cases" data-testid="case-cards">
                @foreach (var c in page.Items)
                {
                    <li class="record-card">
                        <div class="record-card__top">
                            <div class="record-card__title"><a href="@($"cases/{c.Id}")">@c.Title</a></div>
                            <StatusPill Status="c.Status" Large="true" />
                        </div>
                        <span class="row-desc @(string.IsNullOrWhiteSpace(c.DescriptionPreview) ? "row-desc--empty" : null)">@Preview(c.DescriptionPreview)</span>
                        <div class="record-card__meta">
                            <span class="case-id">#@c.Id</span>
                            <PriorityBadge Priority="c.Priority" />
                            <span>Due @UiText.DueDate(c.DueOn)</span>
                            <span>@UiText.Owner(c.AssignedTo)</span>
                        </div>
                    </li>
                }
            </ul>
            <PagerControl Page="_state.Page" PageSize="_state.PageSize" TotalCount="page.TotalCount" Noun="cases" Label="Case list pages"
                          PageSizes="CaseListState.PageSizes" OnPageChanged="GoToPageAsync" OnPageSizeChanged="PageSizeAsync"
                          Announce="false" TestIdPrefix="page" IdPrefix="page" />
        }
    }
</div>

@code {
    private sealed record Column(CaseSortField? Field, string Text);

    private sealed record Chip(string Text, Func<CaseListState, CaseListState> Remove);

    private static readonly TimeSpan SearchDelay = TimeSpan.FromMilliseconds(300);
    private static readonly CaseStatus[] OpenStatuses = [CaseStatus.New, CaseStatus.Triaged, CaseStatus.InProgress];
    private static readonly CaseStatus[] CompletedStatuses = [CaseStatus.Resolved, CaseStatus.Closed];

    private static readonly Column[] Columns =
    [
        new(CaseSortField.Id, "ID"),
        new(CaseSortField.Title, "Title"),
        new(CaseSortField.Status, "Status"),
        new(CaseSortField.Priority, "Priority"),
        new(CaseSortField.Category, "Category"),
        new(CaseSortField.Owner, "Owner"),
        new(CaseSortField.DueOn, "Due date (ET)"),
        new(CaseSortField.UpdatedAt, "Updated (ET)"),
        new(null, "Actions"),
    ];

    private static readonly (string Value, string Text)[] SortOptions =
    [
        ("UpdatedAt:desc", "Recently updated"), ("UpdatedAt:asc", "Least recently updated"),
        ("CreatedAt:desc", "Newest"), ("CreatedAt:asc", "Oldest"),
        ("DueOn:asc", "Due soonest"), ("Priority:desc", "Highest priority"),
        ("Title:asc", "Title A to Z"), ("Title:desc", "Title Z to A"),
        ("Status:asc", "Status (New first)"), ("Id:desc", "ID (highest first)"), ("Id:asc", "ID (lowest first)"),
    ];

    private readonly CancellationTokenSource _cts = new();
    private CancellationTokenSource? _searchDebounce;
    private CancellationTokenSource? _loadCts;
    private int _loadVersion;
    private CaseListState _state = CaseListState.Default;
    private PagedResult<CaseSummaryDto>? _result;
    private bool _loading;
    private bool _refreshing;
    private string? _error;
    private string? _announcement;
    private string? _searchDraft;
    private string? _me;
    private IReadOnlyList<AssigneeDto> _assignees = [];
    private DateOnly _today;
    private bool _dueRangeRejected;

    // Declared so that the router re-supplies parameters when only the query string changes.
    [SupplyParameterFromQuery(Name = "page")] private int? QueryPage { get; set; }
    [SupplyParameterFromQuery(Name = "size")] private int? QuerySize { get; set; }
    [SupplyParameterFromQuery(Name = "status")] private string[]? QueryStatus { get; set; }
    [SupplyParameterFromQuery(Name = "q")] private string? QuerySearch { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] private string? QuerySort { get; set; }
    [SupplyParameterFromQuery(Name = "dir")] private string? QueryDirection { get; set; }
    [SupplyParameterFromQuery(Name = "priority")] private string[]? QueryPriority { get; set; }
    [SupplyParameterFromQuery(Name = "category")] private string[]? QueryCategory { get; set; }
    [SupplyParameterFromQuery(Name = "owner")] private string? QueryOwner { get; set; }
    [SupplyParameterFromQuery(Name = "overdue")] private string? QueryOverdue { get; set; }
    [SupplyParameterFromQuery(Name = "createdFrom")] private string? QueryCreatedFrom { get; set; }
    [SupplyParameterFromQuery(Name = "createdTo")] private string? QueryCreatedTo { get; set; }
    [SupplyParameterFromQuery(Name = "updatedFrom")] private string? QueryUpdatedFrom { get; set; }
    [SupplyParameterFromQuery(Name = "updatedTo")] private string? QueryUpdatedTo { get; set; }
    [SupplyParameterFromQuery(Name = "dueFrom")] private string? QueryDueFrom { get; set; }
    [SupplyParameterFromQuery(Name = "dueTo")] private string? QueryDueTo { get; set; }

    private int PageCount => _result is { TotalCount: > 0 } r ? (int)Math.Ceiling(r.TotalCount / (double)_state.PageSize) : 1;
    private bool HasFilters => _state.Statuses.Count > 0 || _state.Search is not null || _state.HasExtraFilters || !string.IsNullOrWhiteSpace(_searchDraft);
    private bool DueRangeInvalid => _dueRangeRejected;
    private string CountText => _result is { } r ? $"({UiText.Number(r.TotalCount)} {(r.TotalCount == 1 ? "case" : "cases")}{(HasFilters ? " match the filters" : "")})" : "";
    private string ExportLabel => HasFilters ? "Export filtered CSV" : "Export all to CSV";
    private string SortValue => $"{_state.SortBy}:{(_state.Direction == SortDirection.Ascending ? "asc" : "desc")}";
    private string ExportHref => Navigation.GetUriWithQueryParameters("exports/cases.csv", _state.ToQueryParameters().Where(p => p.Key is not ("page" or "size")).ToDictionary());

    private static string Preview(string? description) =>
        string.IsNullOrWhiteSpace(description) ? "No description provided." : string.Join(' ', description.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));

    private static string Encode<T>(IEnumerable<T> values) where T : struct, Enum => string.Join(',', values.Order());

    private static List<T> Decode<T>(object? value) where T : struct, Enum =>
        [.. (value?.ToString() ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(v => Enum.TryParse<T>(v, out var parsed) && Enum.IsDefined(parsed) ? parsed : (T?)null)
            .OfType<T>().Distinct().Order()];

    private static bool IsPreset(IReadOnlyList<CaseStatus> statuses) =>
        statuses.Order().SequenceEqual(OpenStatuses) || statuses.Order().SequenceEqual(CompletedStatuses);

    private IReadOnlyList<Chip> DateChips
    {
        get
        {
            List<Chip> chips = [];
            if (_state.CreatedFrom is not null || _state.CreatedTo is not null)
            {
                chips.Add(new Chip($"Created {Range(_state.CreatedFrom, _state.CreatedTo)}", s => s with { CreatedFrom = null, CreatedTo = null, Page = 1 }));
            }
            if (_state.UpdatedFrom is not null || _state.UpdatedTo is not null)
            {
                chips.Add(new Chip($"Updated {Range(_state.UpdatedFrom, _state.UpdatedTo)}", s => s with { UpdatedFrom = null, UpdatedTo = null, Page = 1 }));
            }
            return chips;
        }
    }

    private static string Range(DateOnly? from, DateOnly? to) => (from, to) switch
    {
        ({ } f, { } t) => $"{UiText.DueDate(f)} to {UiText.DueDate(t)}",
        ({ } f, null) => $"on or after {UiText.DueDate(f)}",
        (null, { } t) => $"on or before {UiText.DueDate(t)}",
        _ => string.Empty,
    };

    protected override async Task OnInitializedAsync()
    {
        _me = CaseDashboardService.UserNameOf(await CurrentUser.GetAsync(_cts.Token));
        try
        {
            var assignees = await Assignees.ListAsync(_cts.Token);
            _assignees = assignees.IsSuccess ? assignees.Value! : [];
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // The owner filter still offers Me and Unassigned.
            Logger.LogWarning(new EventId(5010, "AssigneeListFailed"), "Assignee list failed ({ExceptionType})", ex.GetType().Name);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        _state = CaseListState.Parse(key => query.TryGetValue(key, out var values) ? [.. values.OfType<string>()] : []);
        // Keep what the user is typing: only take the URL's search when no search is pending and it really differs.
        if (_searchDebounce is null && (_searchDraft?.Trim() ?? "") != (_state.Search ?? ""))
        {
            _searchDraft = _state.Search;
        }
        await LoadAsync();
    }

    private async Task RefreshAsync()
    {
        _refreshing = true;
        try
        {
            await Task.WhenAll(LoadAsync(), Task.Delay(TimeSpan.FromMilliseconds(400), _cts.Token));
            if (_error is null && _result is { } r)
            {
                Announcer.Announce($"Case list refreshed. {UiText.ShowingRange(_state.Page, _state.PageSize, r.TotalCount, "cases")}.");
            }
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
        finally
        {
            _refreshing = false;
        }
    }

    private async Task LoadAsync()
    {
        // Every load supersedes the previous one: cancel it and ignore its response if it still arrives.
        var version = ++_loadVersion;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = CancellationTokenSource.CreateLinkedTokenSource(_cts.Token);
        var token = _loadCts.Token;
        using var busy = Activity.Begin();
        _loading = true;
        _error = null;
        _today = UiText.Today(Time);
        try
        {
            var result = await Cases.ListAsync(_state.ToQuery(), token);
            if (version != _loadVersion)
            {
                return;
            }
            if (result.IsSuccess)
            {
                _result = result.Value;
                // A page past the end (for example from an old link) shows the last page instead of nothing.
                if (_result!.Items.Count == 0 && _result.TotalCount > 0 && _state.Page > 1)
                {
                    await NavigateAsync(_state with { Page = PageCount });
                    return;
                }
                _announcement = _result.TotalCount == 0
                    ? "No cases match the current filters."
                    : $"{UiText.Number(_result.TotalCount)} {(_result.TotalCount == 1 ? "case" : "cases")} found. {UiText.ShowingRange(_state.Page, _state.PageSize, _result.TotalCount, "cases")}. Page {_state.Page} of {PageCount}.";
            }
            else
            {
                _result = null;
                _error = result.Error!.Message;
                _announcement = null;
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            if (version != _loadVersion)
            {
                return;
            }
            Logger.LogError(new EventId(5002, "CaseListLoadFailed"), "Case list load failed ({ExceptionType})", ex.GetType().Name);
            _result = null;
            _error = "The case list could not be loaded. Try again.";
        }
        finally
        {
            if (version == _loadVersion)
            {
                _loading = false;
            }
        }
    }

    private Task NavigateAsync(CaseListState state)
    {
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(state.ToQueryParameters()));
        return Task.CompletedTask;
    }

    /// <summary>Any filter change: back to page 1, applied immediately.</summary>
    private Task ApplyAsync(Func<CaseListState, CaseListState> change) => NavigateAsync(change(_state) with { Page = 1 });

    // @bind (not value= with @oninput) so a slow round trip never overwrites characters still being typed.
    private async Task SearchChangedAsync()
    {
        _searchDebounce?.Cancel();
        _searchDebounce?.Dispose();
        var debounce = _searchDebounce = CancellationTokenSource.CreateLinkedTokenSource(_cts.Token);
        try
        {
            await Task.Delay(SearchDelay, debounce.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        _searchDebounce = null;
        debounce.Dispose();
        await ApplySearchAsync();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _searchDebounce?.Cancel();
            _searchDebounce = null;
            await ApplySearchAsync();
        }
    }

    private Task ApplySearchAsync()
    {
        var search = string.IsNullOrWhiteSpace(_searchDraft) ? null : _searchDraft.Trim();
        return search == _state.Search ? Task.CompletedTask : ApplyAsync(s => s with { Search = search });
    }

    private Task StatusChangedAsync(ChangeEventArgs e) => ApplyAsync(s => s with { Statuses = Decode<CaseStatus>(e.Value) });

    private Task PriorityChangedAsync(ChangeEventArgs e) => ApplyAsync(s => s with { Priorities = Decode<CasePriority>(e.Value) });

    private Task CategoryChangedAsync(ChangeEventArgs e) => ApplyAsync(s => s with { Categories = Decode<CaseCategory>(e.Value) });

    private Task OwnerChangedAsync(ChangeEventArgs e) =>
        ApplyAsync(s => s with { Owner = e.Value?.ToString() is { Length: > 0 } owner ? owner : null });

    private Task OverdueChangedAsync(ChangeEventArgs e) => ApplyAsync(s => s with { Overdue = e.Value is true });

    private Task DueFromChangedAsync(DateOnly? from) => ApplyDueAsync(from, _state.DueTo);

    private Task DueToChangedAsync(DateOnly? to) => ApplyDueAsync(_state.DueFrom, to);

    private Task ApplyDueAsync(DateOnly? from, DateOnly? to)
    {
        // A reversed range is explained next to the field instead of being sent (the service would reject it).
        _dueRangeRejected = from is not null && to is not null && from > to;
        return _dueRangeRejected ? Task.CompletedTask : ApplyAsync(s => s with { DueFrom = from, DueTo = to });
    }

    private Task ClearFiltersAsync()
    {
        _searchDebounce?.Cancel();
        _searchDebounce = null;
        _searchDraft = null;
        _dueRangeRejected = false;
        Announcer.Announce("Filters cleared.");
        return NavigateAsync(_state.WithoutFilters());
    }

    private Task SortAsync(CaseSortField field) => NavigateAsync(_state.SortedBy(field));

    private Task SortFromSelectAsync(ChangeEventArgs e)
    {
        var parts = (e.Value?.ToString() ?? string.Empty).Split(':');
        if (parts.Length == 2 && Enum.TryParse<CaseSortField>(parts[0], out var field))
        {
            return NavigateAsync(_state with { SortBy = field, Direction = parts[1] == "asc" ? SortDirection.Ascending : SortDirection.Descending, Page = 1 });
        }
        return Task.CompletedTask;
    }

    private Task GoToPageAsync(int page) => NavigateAsync(_state with { Page = Math.Clamp(page, 1, PageCount) });

    private Task PageSizeAsync(int size) => NavigateAsync(_state with { PageSize = size, Page = 1 });

    private string? AriaSort(CaseSortField field) => _state.SortBy != field ? null
        : _state.Direction == SortDirection.Ascending ? "ascending" : "descending";

    /// <summary>▲ / ▼ on the sorted column, ⇅ on the others (decorative; aria-sort carries the state).</summary>
    private string SortGlyph(CaseSortField field) => _state.SortBy != field ? "⇅"
        : _state.Direction == SortDirection.Ascending ? "▲" : "▼";

    public void Dispose()
    {
        _cts.Cancel();
        _searchDebounce?.Dispose();
        _loadCts?.Dispose();
        _cts.Dispose();
    }
}
