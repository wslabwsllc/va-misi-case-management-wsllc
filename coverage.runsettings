<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage settings for scripts/coverage.sh (Microsoft.CodeCoverage, which Microsoft.NET.Test.Sdk already brings).
     Measures the application assemblies only. The exclusions are code with no behaviour of its own to test; everything
     else counts, including code that only the PostgreSQL integration suite can exercise. See docs/testing.md. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <CodeCoverage>
            <ModulePaths>
              <Include>
                <ModulePath>.*[\\/]CaseIntake\.[^\\/]*\.dll$</ModulePath>
              </Include>
              <Exclude>
                <ModulePath>.*[\\/]CaseIntake\.[^\\/]*Tests\.dll$</ModulePath>
                <ModulePath>.*[\\/]CaseIntake\.TestKit\.dll$</ModulePath>
                <ModulePath>.*[\\/]CaseIntake\.E2E\.dll$</ModulePath>
              </Exclude>
            </ModulePaths>
            <Sources>
              <Exclude>
                <!-- EF Core migrations and model snapshot: generated by dotnet-ef; MigrationTests checks the schema. -->
                <Source>.*[\\/]Migrations[\\/].*</Source>
                <!-- Used only by the dotnet-ef command-line tool at design time, never at run time. -->
                <Source>.*[\\/]DesignTimeDbContextFactory\.cs$</Source>
                <!-- Source generator output (LoggerMessage, Regex, Razor, System.Text.Json). -->
                <Source>.*[\\/]obj[\\/].*</Source>
              </Exclude>
            </Sources>
            <Attributes>
              <Exclude>
                <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
                <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
              </Exclude>
            </Attributes>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
